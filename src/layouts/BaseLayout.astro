---
import '../styles/global.css';
import type { Lang } from '../i18n/ui';
import { useTranslations, withBase } from '../i18n/utils';
import SEO from '../components/SEO.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  lang: Lang;
  /** Bu sayfanın yolu (canonical). */
  path: string;
  /** Karşı dildeki eş sayfanın yolu (hreflang + dil değiştirici). */
  altPath: string;
  includeOrgSchema?: boolean;
}

const {
  title,
  description,
  lang,
  path,
  altPath,
  includeOrgSchema = false,
} = Astro.props;
const t = useTranslations(lang);

// Dağıtım base'ini ekle (demolar alt yolda yayınlanır)
const basedPath = withBase(path);
const basedAltPath = withBase(altPath);
// Demo dağıtımlarını (base !== '/') arama motorlarından gizle
const isDemo = import.meta.env.BASE_URL !== '/';
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    {isDemo && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <SEO
      title={title}
      description={description}
      lang={lang}
      path={basedPath}
      altPath={basedAltPath}
      includeOrgSchema={includeOrgSchema}
    />
  </head>
  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-[100] focus:bg-garnet-bright focus:px-4 focus:py-2 focus:text-sm focus:font-semibold focus:text-night"
    >
      {t('a11y.skip')}
    </a>
    <Header lang={lang} altPath={basedAltPath} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
