---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import { useTranslations, withBase } from '../../i18n/utils';
import { getInsights, formatDate } from '../../lib/insights';

const lang = 'tr' as const;
const t = useTranslations(lang);
const posts = await getInsights(lang);
const title = 'Güncel | Tüfek & Türkan Hukuk Bürosu';
const description = 'Hukuki gelişmeler ve büromuzdan haberler.';
---

<BaseLayout
  lang={lang}
  title={title}
  description={description}
  path="/guncel"
  altPath="/en/insights"
>
  <PageHeader eyebrow={t('insights.title')} title={t('insights.title')} subtitle={t('insights.subtitle')} />
  <section class="bg-night">
    <div class="mx-auto max-w-4xl px-4 py-16 sm:px-6 lg:px-8 lg:py-24">
      {
        posts.length === 0 ? (
          <p class="text-base text-ivory-faint">{t('insights.empty')}</p>
        ) : (
          <div class="space-y-10">
            {posts.map((post) => (
              <article class="border-b border-line pb-10 last:border-b-0">
                <a href={withBase(`/guncel/${post.data.slug}`)} class="group block">
                  <p class="text-xs font-medium uppercase tracking-wide text-garnet-bright">
                    {formatDate(post.data.pubDate, lang)}
                  </p>
                  <h2 class="mt-2 font-display text-2xl font-semibold leading-snug text-ivory transition-colors group-hover:text-garnet-bright">
                    {post.data.title}
                  </h2>
                  <p class="mt-2 text-base leading-relaxed text-ivory-faint">{post.data.description}</p>
                </a>
              </article>
            ))}
          </div>
        )
      }
    </div>
  </section>
</BaseLayout>
