---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import { useTranslations } from '../i18n/utils';
import { usefulLinks } from '../data/site';

const lang = 'tr' as const;
const t = useTranslations(lang);
const title = 'Faydalı Linkler | Tüfek & Türkan Hukuk Bürosu';
const description =
  'Adliye rehberi, Resmî Gazete, Ticaret Sicil Gazetesi, baro ücret tarifesi ve enflasyon oranları gibi sıkça başvurulan resmî kaynaklar.';
---

<BaseLayout
  lang={lang}
  title={title}
  description={description}
  path="/faydali-linkler"
  altPath="/en/useful-links"
>
  <PageHeader eyebrow={t('links.title')} title={t('links.title')} subtitle={t('links.subtitle')} />
  <section class="bg-paper">
    <div class="mx-auto max-w-3xl px-4 py-16 sm:px-6 lg:px-8 lg:py-24">
      <ul class="divide-y divide-ink/10 border-y border-ink/10">
        {
          usefulLinks.map((link) => (
            <li>
              <a
                href={link.url}
                target="_blank"
                rel="noopener noreferrer"
                class="group flex items-center justify-between gap-4 py-5 transition-colors hover:bg-paper-2"
              >
                <span class="font-serif text-lg font-medium text-ink transition-colors group-hover:text-brass-deep">
                  {link.title[lang]}
                </span>
                <span class="shrink-0 text-brass-deep" aria-label={t('links.external')}>
                  <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H18m0 0v4.5M18 6l-8 8M16 13.5V18a1.5 1.5 0 0 1-1.5 1.5h-9A1.5 1.5 0 0 1 4 18V9a1.5 1.5 0 0 1 1.5-1.5H10" />
                  </svg>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</BaseLayout>
