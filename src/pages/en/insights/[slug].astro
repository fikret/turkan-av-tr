---
import { render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { useTranslations, withBase } from '../../../i18n/utils';
import { getInsights, formatDate, readingTime } from '../../../lib/insights';

export async function getStaticPaths() {
  const posts = await getInsights('en');
  return posts.map((post) => ({
    params: { slug: post.data.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const lang = 'en' as const;
const t = useTranslations(lang);
const { Content } = await render(post);
const mins = readingTime(post.body);
const trPosts = await getInsights('tr');
const trMatch = trPosts.find((p) => p.data.slug === post.data.slug);
const altPath = trMatch ? `/guncel/${trMatch.data.slug}` : '/guncel';
---

<BaseLayout
  lang={lang}
  title={`${post.data.title} | Tüfek & Türkan Law Firm`}
  description={post.data.description}
  path={`/en/insights/${post.data.slug}`}
  altPath={altPath}
>
  <article class="bg-paper">
    <div class="mx-auto max-w-3xl px-4 py-16 sm:px-6 lg:px-8 lg:py-24">
      <a href={withBase('/en/insights')} class="text-sm font-semibold text-brass-deep transition-colors hover:text-forest">
        &larr; {t('insights.back')}
      </a>
      <header class="mt-6">
        <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-xs font-medium uppercase tracking-wide text-brass-deep">
          <span>{formatDate(post.data.pubDate, lang)}</span>
          <span aria-hidden="true">·</span>
          <span>{mins} {t('insights.readingTime')}</span>
        </div>
        <h1 class="mt-3 font-serif text-4xl font-semibold leading-tight text-ink">{post.data.title}</h1>
        <p class="mt-4 text-lg leading-relaxed text-ink-faint">{post.data.description}</p>
      </header>
      <div class="prose-content mt-10">
        <Content />
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .prose-content :global(h2) {
    font-family: var(--font-serif);
    font-size: 1.6rem;
    font-weight: 600;
    color: var(--color-ink);
    margin-top: 2rem;
    margin-bottom: 0.75rem;
  }
  .prose-content :global(h3) {
    font-family: var(--font-serif);
    font-size: 1.3rem;
    font-weight: 600;
    color: var(--color-ink);
    margin-top: 1.5rem;
    margin-bottom: 0.5rem;
  }
  .prose-content :global(p) {
    color: var(--color-ink-soft);
    line-height: 1.8;
    margin-bottom: 1.1rem;
  }
  .prose-content :global(ul),
  .prose-content :global(ol) {
    margin: 1rem 0 1.25rem 1.25rem;
    color: var(--color-ink-soft);
    line-height: 1.8;
  }
  .prose-content :global(ul) { list-style: disc; }
  .prose-content :global(ol) { list-style: decimal; }
  .prose-content :global(li) { margin-bottom: 0.4rem; }
  .prose-content :global(a) {
    color: var(--color-brass-deep);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .prose-content :global(strong) { color: var(--color-ink); font-weight: 600; }
  .prose-content :global(blockquote) {
    border-left: 3px solid var(--color-brass);
    padding-left: 1rem;
    font-style: italic;
    color: var(--color-ink-faint);
    margin: 1.5rem 0;
  }
</style>
