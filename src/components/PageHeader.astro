---
interface Props {
  eyebrow: string;
  title: string;
  subtitle?: string;
}

const { eyebrow, title, subtitle } = Astro.props;
---

<section class="relative isolate overflow-hidden bg-forest-deep text-cream">
  <div
    class="absolute inset-0 -z-10"
    aria-hidden="true"
    style="background: linear-gradient(115deg, oklch(0.19 0.03 162) 0%, oklch(0.26 0.04 160) 60%, oklch(0.22 0.036 160) 100%);"
  >
    <div
      class="absolute inset-0 opacity-[0.5]"
      style="background: radial-gradient(60% 80% at 85% 15%, oklch(0.70 0.085 76 / 0.18), transparent 60%);"
    ></div>
  </div>
  <div class="mx-auto max-w-[78rem] px-5 py-24 sm:px-8 lg:py-28">
    <h1 class="t-display anim-rise max-w-3xl text-cream" style="font-size: clamp(2.4rem, 1.6rem + 3.4vw, 4rem);">
      {title}
    </h1>
    <div class="rule-brass anim-rule mt-7 w-24"></div>
    {subtitle && <p class="t-lead anim-rise-2 prose-measure mt-7 text-cream-soft">{subtitle}</p>}
  </div>
</section>
