---
interface Props {
  eyebrow?: string;
  title: string;
  subtitle?: string;
}

const { title, subtitle } = Astro.props;
---

<section class="border-b border-line bg-paper">
  <div class="mx-auto max-w-[78rem] px-6 pb-12 pt-16 sm:px-10 sm:pb-16 sm:pt-20">
    <h1 class="t-display anim-rise max-w-[20ch] text-ink">{title}</h1>
    {subtitle && <p class="t-lead prose-justify anim-rise-2 mt-6 max-w-[42rem]">{subtitle}</p>}
  </div>
</section>
