---
interface Props {
  eyebrow?: string;
  title: string;
  subtitle?: string;
}

const { title, subtitle } = Astro.props;
---

<section class="relative isolate overflow-hidden border-b border-line bg-night text-ivory">
  <div
    class="absolute inset-0 -z-10 opacity-70"
    aria-hidden="true"
    style="background: radial-gradient(60% 90% at 82% 8%, oklch(0.56 0.135 24 / 0.18), transparent 60%);"
  ></div>
  <div class="mx-auto max-w-[80rem] px-5 py-24 sm:px-8 lg:py-28">
    <h1 class="t-display anim-rise max-w-3xl text-ivory" style="font-size: clamp(2.5rem, 1.6rem + 3.6vw, 4.4rem);">
      {title}
    </h1>
    <div class="rule-garnet anim-rule mt-7 w-24"></div>
    {subtitle && <p class="t-lead anim-rise-2 prose-measure mt-7">{subtitle}</p>}
  </div>
</section>
