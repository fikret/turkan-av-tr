---
interface Props {
  eyebrow?: string;
  title: string;
  subtitle?: string;
}

const { title, subtitle } = Astro.props;
---

<section class="bg-ash pb-12 pt-[8.5rem] sm:pt-[10rem]">
  <div class="mx-auto max-w-[1100px] px-5 text-center sm:px-8">
    <h1 class="t-display anim-rise mx-auto max-w-[20ch] text-ink">{title}</h1>
    {subtitle && (
      <p class="anim-rise-2 mx-auto mt-5 max-w-[46ch] text-[1.1rem] leading-relaxed text-smoke">{subtitle}</p>
    )}
  </div>
</section>
