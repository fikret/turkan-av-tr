---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import type { Lang } from '../i18n/ui';
import { useTranslations, routeMap } from '../i18n/utils';
import { practiceAreas } from '../data/practice-areas';

interface Props {
  lang: Lang;
  /** true: görselli editoryal satırlar (Çalışma Alanları sayfası). false: tipografik dizin (ana sayfa). */
  full?: boolean;
}

const { lang, full = false } = Astro.props;
const t = useTranslations(lang);
const practicePath = routeMap.practice[lang];

const practiceImages = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/practice/*.{jpg,jpeg,png,webp,avif}',
  { eager: true }
);
function imageFor(slug: string): ImageMetadata | null {
  const match = Object.entries(practiceImages).find(([path]) =>
    path.toLowerCase().includes(`/${slug}.`)
  );
  return match ? match[1].default : null;
}
---

<section id="calisma-alanlari" class={full ? 'bg-paper' : 'bg-paper-2'}>
  <div class="mx-auto max-w-[78rem] px-5 py-24 sm:px-8 lg:py-32">
    <div class="max-w-2xl">
      <h2 class="t-h2 text-forest">{t('practice.title')}</h2>
      <div class="rule-brass mt-7 w-20"></div>
      <p class="t-lead mt-7 text-ink-soft prose-measure">{t('practice.subtitle')}</p>
    </div>

    {
      !full ? (
        /* Ana sayfa: tipografik dizin (içindekiler estetiği) */
        <>
          <ul class="mt-14 grid border-t border-line sm:grid-cols-2">
            {practiceAreas.map((area) => (
              <li class="border-b border-line">
                <a
                  href={`${practicePath}#${area.slug}`}
                  class="group flex items-center justify-between gap-4 py-4 pr-1 transition-colors duration-300 sm:py-[1.15rem]"
                >
                  <span class="font-serif text-[1.32rem] leading-snug text-ink transition-colors duration-300 group-hover:text-brass-deep">
                    {area.name[lang]}
                  </span>
                  <span
                    class="shrink-0 translate-x-0 text-brass opacity-0 transition-all duration-300 group-hover:translate-x-1 group-hover:opacity-100"
                    aria-hidden="true"
                  >
                    &rarr;
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </>
      ) : (
        /* Çalışma Alanları sayfası: görselli editoryal satırlar */
        <div class="mt-16 space-y-20 lg:space-y-28">
          {practiceAreas.map((area, i) => (
            <article
              id={area.slug}
              class="scroll-mt-28 grid items-center gap-8 lg:grid-cols-2 lg:gap-16"
            >
              <div class={i % 2 === 1 ? 'lg:order-2' : ''}>
                {imageFor(area.slug) ? (
                  <div class="overflow-hidden">
                    <Image
                      src={imageFor(area.slug)!}
                      alt={area.name[lang]}
                      widths={[600, 900, 1200]}
                      sizes="(max-width: 1024px) 100vw, 560px"
                      class="aspect-[4/3] w-full object-cover transition-transform duration-700 hover:scale-[1.03]"
                    />
                  </div>
                ) : (
                  <div
                    class="aspect-[4/3] w-full"
                    aria-hidden="true"
                    style={`background: linear-gradient(135deg, ${area.gradient[1]} 0%, ${area.gradient[0]} 100%);`}
                  />
                )}
              </div>
              <div class={i % 2 === 1 ? 'lg:order-1' : ''}>
                <div class="rule-brass w-12"></div>
                <h3 class="t-h3 mt-5 text-forest">{area.name[lang]}</h3>
                <p class="prose-measure mt-4 text-[1.02rem] leading-[1.7] text-ink-soft">
                  {area.description[lang]}
                </p>
              </div>
            </article>
          ))}
        </div>
      )
    }

    {
      !full && (
        <div class="mt-12">
          <a
            href={routeMap.practice[lang]}
            class="group inline-flex items-center gap-2 text-sm font-semibold text-forest transition-colors duration-300 hover:text-brass-deep"
          >
            {t('practice.all')}
            <span class="transition-transform duration-300 group-hover:translate-x-1" aria-hidden="true">&rarr;</span>
          </a>
        </div>
      )
    }
  </div>
</section>
