---
import type { Lang } from '../i18n/ui';
import { useTranslations, routeMap } from '../i18n/utils';
import { practiceAreas } from '../data/practice-areas';

interface Props {
  lang: Lang;
  full?: boolean;
}

const { lang, full = false } = Astro.props;
const t = useTranslations(lang);
const practicePath = routeMap.practice[lang];
---

<section id="calisma-alanlari" class="bg-cream">
  <div class="mx-auto max-w-[1200px] px-5 py-20 sm:px-8 sm:py-24 lg:py-28">
    <div class="max-w-[44rem]">
      <p class="t-mono-label text-ink/70">{t('practice.title')}</p>
      <h2 class="t-h2 mt-4 text-ink">{t('practice.subtitle')}</h2>
    </div>

    {
      !full ? (
        /* Ana sayfa: bordürlü matris (program ızgarası) */
        <div class="mt-12 grid grid-cols-1 border-l border-t border-ink sm:grid-cols-2 lg:grid-cols-3">
          {practiceAreas.map((area) => (
            <a
              href={`${practicePath}#${area.slug}`}
              class="group flex items-center justify-between gap-3 border-b border-r border-ink px-5 py-6 transition-colors duration-150 hover:bg-butter"
            >
              <span class="text-[1.05rem] font-medium leading-snug text-ink">{area.name[lang]}</span>
              <span class="shrink-0 text-ink opacity-0 transition-opacity duration-150 group-hover:opacity-100" aria-hidden="true">&rarr;</span>
            </a>
          ))}
          <a
            href={practicePath}
            class="group flex items-center justify-between gap-3 border-b border-r border-ink bg-ink px-5 py-6 text-cream transition-colors duration-150"
          >
            <span class="text-[0.92rem] font-bold uppercase tracking-wide">{t('practice.all')}</span>
            <span aria-hidden="true">&rarr;</span>
          </a>
        </div>
      ) : (
        /* Detay: outlined kartlar */
        <div class="mt-12 grid gap-6 md:grid-cols-2">
          {practiceAreas.map((area) => (
            <article id={area.slug} class="frame scroll-mt-28 bg-white p-7 sm:p-9">
              <div class="flex items-start gap-3">
                <span class="mt-2 h-2.5 w-2.5 shrink-0 bg-butter ring-1 ring-ink" aria-hidden="true"></span>
                <h3 class="t-h3 text-ink">{area.name[lang]}</h3>
              </div>
              <p class="mt-3 text-[1.02rem] leading-[1.6] text-ink/85">{area.description[lang]}</p>
            </article>
          ))}
        </div>
      )
    }
  </div>
</section>
