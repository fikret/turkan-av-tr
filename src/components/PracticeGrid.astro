---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import type { Lang } from '../i18n/ui';
import { useTranslations, routeMap } from '../i18n/utils';
import { practiceAreas } from '../data/practice-areas';

interface Props {
  lang: Lang;
  full?: boolean;
}

const { lang, full = false } = Astro.props;
const t = useTranslations(lang);
const practicePath = routeMap.practice[lang];

const practiceImages = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/practice/*.{jpg,jpeg,png,webp,avif}',
  { eager: true }
);
function imageFor(slug: string): ImageMetadata | null {
  const match = Object.entries(practiceImages).find(([path]) =>
    path.toLowerCase().includes(`/${slug}.`)
  );
  return match ? match[1].default : null;
}
---

<section id="calisma-alanlari" class={full ? 'bg-ash py-[80px] sm:py-[100px]' : 'bg-paper py-[88px] sm:py-[110px]'}>
  <div class="mx-auto max-w-[1100px] px-5 sm:px-8">
    <div class="text-center">
      <h2 class="t-h2 text-ink">{t('practice.title')}</h2>
      <p class="mx-auto mt-4 max-w-[46ch] text-[1.1rem] leading-relaxed text-smoke">{t('practice.subtitle')}</p>
    </div>

    {
      !full ? (
        /* Ana sayfa: yuvarlak pill chip'ler */
        <>
          <div class="mx-auto mt-10 flex max-w-[920px] flex-wrap justify-center gap-2.5">
            {practiceAreas.map((area) => (
              <a
                href={`${practicePath}#${area.slug}`}
                class="pill border border-ash-2 bg-ash px-4 py-2.5 text-[0.92rem] font-medium text-ink transition-colors duration-200 hover:bg-blue hover:text-white"
              >
                {area.name[lang]}
              </a>
            ))}
          </div>
          <div class="mt-10 text-center">
            <a
              href={practicePath}
              class="inline-flex items-center gap-1.5 text-[0.95rem] font-semibold text-blue transition-opacity duration-200 hover:opacity-70"
            >
              {t('practice.all')}
              <span aria-hidden="true">&rarr;</span>
            </a>
          </div>
        </>
      ) : (
        /* Detay: editoryal glow-ring çerçeveli bloklar */
        <div class="mx-auto mt-14 max-w-[1000px] space-y-16 lg:space-y-24">
          {practiceAreas.map((area, i) => (
            <article
              id={area.slug}
              class="scroll-mt-28 grid items-center gap-7 lg:grid-cols-2 lg:gap-14"
            >
              <div class={i % 2 === 1 ? 'lg:order-2' : ''}>
                {imageFor(area.slug) ? (
                  <div class="rounded-[30px] bg-paper p-2 glow-ring">
                    <Image
                      src={imageFor(area.slug)!}
                      alt={area.name[lang]}
                      widths={[500, 760, 1000]}
                      sizes="(max-width: 1024px) 92vw, 480px"
                      class="aspect-[4/3] w-full rounded-[22px] object-cover"
                    />
                  </div>
                ) : (
                  <div
                    class="aspect-[4/3] w-full rounded-[30px]"
                    aria-hidden="true"
                    style={`background: linear-gradient(135deg, ${area.gradient[1]} 0%, ${area.gradient[0]} 100%);`}
                  />
                )}
              </div>
              <div class={i % 2 === 1 ? 'lg:order-1' : ''}>
                <h3 class="t-h3 text-ink">{area.name[lang]}</h3>
                <p class="mt-3 text-[1rem] leading-[1.6] text-graphite">{area.description[lang]}</p>
              </div>
            </article>
          ))}
        </div>
      )
    }
  </div>
</section>
