---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import type { Lang } from '../i18n/ui';
import { useTranslations, routeMap } from '../i18n/utils';
import { practiceAreas } from '../data/practice-areas';

interface Props {
  lang: Lang;
  /** true: tam liste + açıklamalar (Çalışma Alanları sayfası). false: ana sayfa özeti. */
  full?: boolean;
}

const { lang, full = false } = Astro.props;
const t = useTranslations(lang);

// src/assets/practice/<slug>.(jpg|jpeg|png|webp) varsa kart görseli olarak kullanılır.
// Dosya silinirse otomatik olarak gradyana döner (build bozulmaz).
const practiceImages = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/practice/*.{jpg,jpeg,png,webp,avif}',
  { eager: true }
);
function imageFor(slug: string): ImageMetadata | null {
  const match = Object.entries(practiceImages).find(([path]) =>
    path.toLowerCase().includes(`/${slug}.`)
  );
  return match ? match[1].default : null;
}

// Ana sayfada kartlar Çalışma Alanları sayfasındaki ilgili alana link olur (#slug);
// tam liste sayfasında ise her kart anchor hedefidir (id + scroll-mt).
const CardTag = full ? 'article' : 'a';
const practicePath = routeMap.practice[lang];
---

<section id="calisma-alanlari" class={full ? 'bg-white' : 'bg-white'}>
  <div class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8 lg:py-28">
    <div class="max-w-2xl">
      <p class="text-sm font-semibold uppercase tracking-[0.18em] text-gold-600">
        {t('practice.title')}
      </p>
      <h2 class="mt-3 font-serif text-3xl font-semibold leading-tight text-ink sm:text-4xl">
        {t('practice.subtitle')}
      </h2>
    </div>

    <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        practiceAreas.map((area) => (
          <CardTag
            id={area.slug}
            href={full ? undefined : `${practicePath}#${area.slug}`}
            aria-label={full ? undefined : area.name[lang]}
            class={`group relative block overflow-hidden rounded-md border border-ink/10 bg-white transition-shadow hover:shadow-lg ${full ? 'scroll-mt-24' : ''}`}
          >
            {/* Görsel varsa fotoğraf, yoksa soyut CSS gradyan (telifsiz fallback) */}
            {imageFor(area.slug) ? (
              <div class="relative h-36 w-full overflow-hidden">
                <Image
                  src={imageFor(area.slug)!}
                  alt={area.name[lang]}
                  widths={[400, 600, 800]}
                  sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 380px"
                  class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.04]"
                />
                <div
                  class="absolute inset-0"
                  aria-hidden="true"
                  style={`background: linear-gradient(180deg, transparent 40%, ${area.gradient[0]}cc 100%);`}
                />
              </div>
            ) : (
              <div
                class="h-28 w-full"
                aria-hidden="true"
                style={`background:
                  radial-gradient(120% 120% at 80% 0%, ${area.gradient[1]} 0%, ${area.gradient[0]} 70%);`}
              >
                <div
                  class="h-full w-full opacity-20"
                  style="background-image: repeating-linear-gradient(125deg, #ffffff 0 1px, transparent 1px 22px);"
                />
              </div>
            )}
            <div class="p-6">
              <h3 class="font-serif text-xl font-semibold text-ink transition-colors group-hover:text-gold-600">{area.name[lang]}</h3>
              {full && (
                <p class="mt-2 text-sm leading-relaxed text-ink-500">{area.description[lang]}</p>
              )}
            </div>
          </CardTag>
        ))
      }
    </div>

    {
      !full && (
        <div class="mt-10">
          <a
            href={routeMap.practice[lang]}
            class="inline-flex items-center gap-2 text-sm font-semibold text-gold-600 transition-colors hover:text-ink"
          >
            {t('practice.all')}
            <span aria-hidden="true">&rarr;</span>
          </a>
        </div>
      )
    }
  </div>
</section>
