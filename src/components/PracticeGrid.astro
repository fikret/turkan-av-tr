---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import type { Lang } from '../i18n/ui';
import { useTranslations, routeMap } from '../i18n/utils';
import { practiceAreas } from '../data/practice-areas';

interface Props {
  lang: Lang;
  full?: boolean;
}

const { lang, full = false } = Astro.props;
const t = useTranslations(lang);
const practicePath = routeMap.practice[lang];

const practiceImages = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/practice/*.{jpg,jpeg,png,webp,avif}',
  { eager: true }
);
function imageFor(slug: string): ImageMetadata | null {
  const match = Object.entries(practiceImages).find(([path]) =>
    path.toLowerCase().includes(`/${slug}.`)
  );
  return match ? match[1].default : null;
}
---

<section id="calisma-alanlari" class="border-t border-line bg-night">
  <div class="mx-auto max-w-[80rem] px-5 py-24 sm:px-8 lg:py-32">
    <div class="max-w-2xl">
      <h2 class="t-h2 text-ivory">{t('practice.title')}</h2>
      <div class="rule-garnet mt-7 w-20"></div>
      <p class="t-lead prose-measure mt-7">{t('practice.subtitle')}</p>
    </div>

    {
      !full ? (
        /* Ana sayfa: hairline ızgara (gölge yok, yapısal) */
        <div class="mt-14 grid grid-cols-1 gap-px border border-line bg-line sm:grid-cols-2 lg:grid-cols-3">
          {practiceAreas.map((area) => (
            <a
              href={`${practicePath}#${area.slug}`}
              class="group flex items-center justify-between gap-4 bg-night px-6 py-7 transition-colors duration-300 hover:bg-night-2"
            >
              <span class="font-display text-[1.35rem] leading-snug text-ivory transition-colors duration-300 group-hover:text-garnet-bright">
                {area.name[lang]}
              </span>
              <span
                class="shrink-0 text-garnet-bright opacity-0 transition-all duration-300 group-hover:translate-x-0.5 group-hover:opacity-100"
                aria-hidden="true"
              >
                &#8599;
              </span>
            </a>
          ))}
          {/* Izgarayı tamamlayan CTA hücresi (18. = 3×6) */}
          <a
            href={practicePath}
            class="group flex items-center justify-between gap-4 bg-night-2 px-6 py-7 transition-colors duration-300 hover:bg-night-3"
          >
            <span class="text-sm font-semibold uppercase tracking-[0.1em] text-garnet-bright">
              {t('practice.all')}
            </span>
            <span class="text-garnet-bright transition-transform duration-300 group-hover:translate-x-1" aria-hidden="true">&rarr;</span>
          </a>
        </div>
      ) : (
        /* Detay sayfası: görselli editoryal satırlar */
        <div class="mt-16 space-y-20 lg:space-y-28">
          {practiceAreas.map((area, i) => (
            <article
              id={area.slug}
              class="scroll-mt-28 grid items-center gap-8 lg:grid-cols-2 lg:gap-16"
            >
              <div class={i % 2 === 1 ? 'lg:order-2' : ''}>
                {imageFor(area.slug) ? (
                  <div class="overflow-hidden border border-line">
                    <Image
                      src={imageFor(area.slug)!}
                      alt={area.name[lang]}
                      widths={[600, 900, 1200]}
                      sizes="(max-width: 1024px) 100vw, 560px"
                      class="aspect-[4/3] w-full object-cover opacity-90 transition-all duration-700 hover:scale-[1.03] hover:opacity-100"
                    />
                  </div>
                ) : (
                  <div
                    class="aspect-[4/3] w-full border border-line"
                    aria-hidden="true"
                    style={`background: linear-gradient(135deg, ${area.gradient[1]} 0%, ${area.gradient[0]} 100%);`}
                  />
                )}
              </div>
              <div class={i % 2 === 1 ? 'lg:order-1' : ''}>
                <div class="rule-garnet w-12"></div>
                <h3 class="t-h3 mt-5 text-ivory">{area.name[lang]}</h3>
                <p class="prose-measure mt-4 text-[1.02rem] leading-[1.7] text-ivory-soft">
                  {area.description[lang]}
                </p>
              </div>
            </article>
          ))}
        </div>
      )
    }
  </div>
</section>
