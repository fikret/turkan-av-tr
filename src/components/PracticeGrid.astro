---
import type { Lang } from '../i18n/ui';
import { useTranslations, routeMap } from '../i18n/utils';
import { practiceAreas } from '../data/practice-areas';

interface Props {
  lang: Lang;
  full?: boolean;
}

const { lang, full = false } = Astro.props;
const t = useTranslations(lang);
const practicePath = routeMap.practice[lang];
---

<section id="calisma-alanlari" class="border-t border-line bg-paper">
  <div class="mx-auto max-w-[78rem] px-6 py-20 sm:px-10 sm:py-28">
    {
      !full && (
        <>
          <h2 class="t-h2 max-w-[22ch] text-ink">{t('practice.title')}</h2>
          <p class="t-lead prose-justify mt-5 max-w-[40rem]">{t('practice.subtitle')}</p>
          <ul class="mt-12 grid border-t border-line sm:grid-cols-2 sm:gap-x-16">
            {practiceAreas.map((area) => (
              <li class="border-b border-line">
                <a href={`${practicePath}#${area.slug}`}
                  class="group flex items-baseline justify-between gap-4 py-4 transition-colors duration-200 hover:text-accent">
                  <span class="font-serif text-[1.3rem] text-ink transition-colors duration-200 group-hover:text-accent">{area.name[lang]}</span>
                  <span class="shrink-0 translate-x-0 text-accent opacity-0 transition-all duration-200 group-hover:translate-x-1 group-hover:opacity-100" aria-hidden="true">&rarr;</span>
                </a>
              </li>
            ))}
          </ul>
        </>
      )
    }

    {
      full && (
        <div class="space-y-10">
          {practiceAreas.map((area, i) => (
            <article id={area.slug} class={`scroll-mt-28 grid gap-x-12 gap-y-3 border-t border-line pt-10 md:grid-cols-12 ${i === 0 ? 'border-t-0 pt-0' : ''}`}>
              <h3 class="t-h3 text-ink md:col-span-4">{area.name[lang]}</h3>
              <p class="prose-justify text-[1.075rem] leading-[1.66] text-ink-soft md:col-span-8">{area.description[lang]}</p>
            </article>
          ))}
        </div>
      )
    }
  </div>
</section>
