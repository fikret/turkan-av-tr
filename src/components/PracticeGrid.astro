---
import type { Lang } from '../i18n/ui';
import { useTranslations, routeMap } from '../i18n/utils';
import { practiceAreas } from '../data/practice-areas';

interface Props {
  lang: Lang;
  full?: boolean;
}

const { lang, full = false } = Astro.props;
const t = useTranslations(lang);
const practicePath = routeMap.practice[lang];
---

<section id="calisma-alanlari" class={full ? 'bg-paper' : 'bg-gunmetal'}>
  <div class="mx-auto max-w-[1280px] px-5 py-[88px] sm:px-8 sm:py-[110px]">
    <div class="grid gap-8 lg:grid-cols-12 lg:gap-6">
      <div class="lg:col-span-3">
        <p class="t-caption text-obsidian">{t('practice.title')}</p>
      </div>
      <div class="lg:col-span-9 lg:pl-10">
        <h2 class="t-h max-w-[20ch] text-obsidian">{t('practice.subtitle')}</h2>
      </div>
    </div>

    {
      !full ? (
        /* Ana sayfa: hairline liste (gunmetal üstü obsidian) */
        <>
          <div class="mt-12 grid sm:grid-cols-2 sm:gap-x-12">
            {practiceAreas.map((area) => (
              <a
                href={`${practicePath}#${area.slug}`}
                class="group flex items-center justify-between gap-4 border-t border-obsidian py-4 transition-opacity hover:opacity-60"
              >
                <span class="t-sub text-obsidian">{area.name[lang]}</span>
                <span class="shrink-0 text-obsidian opacity-0 transition-opacity group-hover:opacity-100" aria-hidden="true">&rarr;</span>
              </a>
            ))}
          </div>
          <div class="mt-10">
            <a href={practicePath} class="btn-pill btn-pill-dark inline-flex items-center gap-2 px-6 py-3 text-[0.95rem]">
              {t('practice.all')}
              <span aria-hidden="true">&rarr;</span>
            </a>
          </div>
        </>
      ) : (
        /* Detay: outlined 8px kartlar */
        <div class="mt-12 grid gap-5 md:grid-cols-2">
          {practiceAreas.map((area) => (
            <article id={area.slug} class="scroll-mt-28 rounded-[8px] border border-obsidian bg-paper p-6 sm:p-8">
              <h3 class="t-hsm text-obsidian">{area.name[lang]}</h3>
              <p class="t-body mt-3 leading-[1.5] text-obsidian/90">{area.description[lang]}</p>
            </article>
          ))}
        </div>
      )
    }
  </div>
</section>
