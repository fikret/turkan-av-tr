---
import type { Lang } from '../i18n/ui';
import { useTranslations, routeMap } from '../i18n/utils';
import { navItems, contact } from '../data/site';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const year = 2026;
---

<footer class="border-t border-linen bg-paper">
  <div class="mx-auto max-w-[1280px] px-5 py-12 sm:px-8">
    <div class="flex flex-col justify-between gap-8 md:flex-row md:items-start">
      <div>
        <p class="text-[1.05rem] font-semibold tracking-[0.02em] text-obsidian">TÜFEK &amp; TÜRKAN</p>
        <p class="t-caption mt-2 max-w-xs text-muted">{t('site.tagline')}</p>
        <p class="t-caption mt-4 text-muted">{contact.addressLines.join(' ')}</p>
        <p class="t-caption mt-1 text-muted">
          <a href={`tel:${contact.phoneHref}`} class="hover:text-obsidian">{contact.phoneDisplay}</a>
          <span aria-hidden="true"> · </span>
          <a href={`mailto:${contact.email}`} class="hover:text-obsidian">{contact.email}</a>
        </p>
      </div>
      <nav class="flex flex-wrap gap-x-6 gap-y-2" aria-label={t('footer.nav')}>
        {
          navItems.map((item) => (
            <a href={routeMap[item.key][lang]} class="t-caption text-muted underline-offset-4 transition-colors hover:text-obsidian hover:underline">
              {t(item.labelKey)}
            </a>
          ))
        }
      </nav>
    </div>
    <div class="mt-10 border-t border-aluminum pt-6 t-caption text-muted">
      &copy; {year} Tüfek &amp; Türkan Hukuk Bürosu. {t('footer.rights')}
    </div>
  </div>
</footer>
