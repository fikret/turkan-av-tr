---
import type { Lang } from '../i18n/ui';
import { useTranslations, routeMap } from '../i18n/utils';
import { navItems, contact } from '../data/site';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const year = 2026;
---

<footer class="border-t border-line bg-night text-ivory-soft">
  <div class="mx-auto max-w-[80rem] px-5 py-16 sm:px-8 lg:py-20">
    <div class="grid gap-12 md:grid-cols-3">
      <div>
        <a href={routeMap.home[lang]} class="font-display text-2xl font-medium text-ivory">Tüfek &amp; Türkan</a>
        <p class="mt-1 text-[0.58rem] font-semibold uppercase tracking-[0.24em] text-garnet-bright">Hukuk Bürosu</p>
        <div class="rule-garnet mt-6 w-16"></div>
        <p class="mt-6 max-w-xs text-sm leading-relaxed text-ivory-faint">{t('site.tagline')}</p>
      </div>

      <div>
        <h2 class="text-[0.72rem] font-semibold uppercase tracking-[0.16em] text-garnet-bright">{t('footer.nav')}</h2>
        <ul class="mt-5 grid grid-cols-2 gap-x-6 gap-y-3">
          {
            navItems.map((item) => (
              <li>
                <a href={routeMap[item.key][lang]} class="text-sm text-ivory-soft transition-colors duration-300 hover:text-garnet-bright">
                  {t(item.labelKey)}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <h2 class="text-[0.72rem] font-semibold uppercase tracking-[0.16em] text-garnet-bright">{t('contact.title')}</h2>
        <address class="mt-5 space-y-2.5 text-sm not-italic leading-relaxed text-ivory-soft">
          <p>{contact.addressLines.join(' ')}</p>
          <p>
            <a href={`tel:${contact.phoneHref}`} class="transition-colors duration-300 hover:text-garnet-bright">{contact.phoneDisplay}</a>
          </p>
          <p>
            <a href={`mailto:${contact.email}`} class="transition-colors duration-300 hover:text-garnet-bright">{contact.email}</a>
          </p>
        </address>
      </div>
    </div>

    <div class="mt-14 border-t border-line pt-6 text-center text-xs text-ivory-faint">
      &copy; {year} Tüfek &amp; Türkan Hukuk Bürosu. {t('footer.rights')}
    </div>
  </div>
</footer>
