---
import type { Lang } from '../i18n/ui';
import { useTranslations, routeMap } from '../i18n/utils';
import { navItems, contact } from '../data/site';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const year = 2026;
---

<footer class="bg-forest-900 text-cream-soft">
  <div class="mx-auto max-w-[78rem] px-5 py-16 sm:px-8 lg:py-20">
    <div class="grid gap-12 md:grid-cols-3">
      {/* Marka */}
      <div>
        <a href={routeMap.home[lang]} class="font-serif text-2xl text-cream">Tüfek &amp; Türkan</a>
        <p class="mt-1 text-[0.62rem] font-semibold uppercase tracking-[0.2em] text-brass">Hukuk Bürosu</p>
        <div class="rule-brass mt-6 w-16"></div>
        <p class="mt-6 max-w-xs text-sm leading-relaxed text-cream-soft/80">{t('site.tagline')}</p>
      </div>

      {/* Menü */}
      <div>
        <h2 class="t-eyebrow text-brass">{t('footer.nav')}</h2>
        <ul class="mt-5 grid grid-cols-2 gap-x-6 gap-y-3">
          {
            navItems.map((item) => (
              <li>
                <a href={routeMap[item.key][lang]} class="text-sm text-cream-soft/85 transition-colors duration-300 hover:text-brass">
                  {t(item.labelKey)}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      {/* İletişim */}
      <div>
        <h2 class="t-eyebrow text-brass">{t('contact.title')}</h2>
        <address class="mt-5 space-y-2.5 text-sm not-italic leading-relaxed text-cream-soft/85">
          <p>{contact.addressLines.join(' ')}</p>
          <p>
            <a href={`tel:${contact.phoneHref}`} class="transition-colors duration-300 hover:text-brass">{contact.phoneDisplay}</a>
          </p>
          <p>
            <a href={`mailto:${contact.email}`} class="transition-colors duration-300 hover:text-brass">{contact.email}</a>
          </p>
        </address>
      </div>
    </div>

    <div class="mt-14 border-t border-cream/10 pt-6 text-center text-xs text-cream-soft/55">
      &copy; {year} Tüfek &amp; Türkan Hukuk Bürosu. {t('footer.rights')}
    </div>
  </div>
</footer>
