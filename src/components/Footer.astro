---
import type { Lang } from '../i18n/ui';
import { useTranslations, routeMap } from '../i18n/utils';
import { navItems, contact } from '../data/site';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const year = 2026;
---

<footer class="border-t border-line bg-paper">
  <div class="mx-auto max-w-[78rem] px-6 py-16 sm:px-10">
    <div class="grid gap-10 md:grid-cols-3">
      <div>
        <a href={routeMap.home[lang]} class="font-serif text-[1.4rem] font-medium text-ink">Tüfek &amp; Türkan</a>
        <p class="mt-3 max-w-xs text-[1rem] leading-relaxed text-ink-soft">{t('site.tagline')}</p>
      </div>
      <div>
        <p class="t-label">{t('footer.nav')}</p>
        <ul class="mt-4 grid grid-cols-2 gap-x-6 gap-y-2.5">
          {navItems.map((item) => (
            <li><a href={routeMap[item.key][lang]} class="text-[1rem] text-ink-soft underline-offset-4 transition-colors hover:text-accent hover:underline">{t(item.labelKey)}</a></li>
          ))}
        </ul>
      </div>
      <div>
        <p class="t-label">{t('contact.title')}</p>
        <address class="mt-4 space-y-2 text-[1rem] not-italic leading-relaxed text-ink-soft">
          <p>{contact.addressLines.join(' ')}</p>
          <p><a href={`tel:${contact.phoneHref}`} class="underline-offset-4 transition-colors hover:text-accent">{contact.phoneDisplay}</a></p>
          <p><a href={`mailto:${contact.email}`} class="underline underline-offset-4 transition-colors hover:text-accent">{contact.email}</a></p>
        </address>
      </div>
    </div>
    <div class="mt-12 border-t border-line pt-6 text-[0.92rem] text-ink-faint">
      &copy; {year} Tüfek &amp; Türkan Hukuk Bürosu. {t('footer.rights')}
    </div>
  </div>
</footer>
