---
import type { Lang } from '../i18n/ui';
import { useTranslations, routeMap } from '../i18n/utils';
import { navItems, contact } from '../data/site';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const year = 2026;
---

<footer class="bg-ash">
  <div class="mx-auto max-w-[1100px] px-5 pb-12 pt-16 sm:px-8">
    <div class="rounded-[28px] border border-ash bg-paper p-8 glow-ring sm:p-10">
      <div class="grid gap-10 md:grid-cols-3">
        <div>
          <a href={routeMap.home[lang]} class="flex items-center gap-2.5">
            <span
              class="flex h-8 w-8 items-center justify-center rounded-full text-[0.62rem] font-semibold text-white"
              style="background: linear-gradient(150deg, #4a7ff2 0%, #7b7ed8 60%, #c98ab5 100%);"
              aria-hidden="true">T&amp;T</span>
            <span class="text-[1rem] font-semibold tracking-[-0.02em] text-ink">Tüfek &amp; Türkan</span>
          </a>
          <p class="mt-4 max-w-xs text-sm leading-relaxed text-smoke">{t('site.tagline')}</p>
        </div>

        <div>
          <h2 class="text-[0.7rem] font-semibold uppercase tracking-[0.12em] text-smoke">{t('footer.nav')}</h2>
          <ul class="mt-4 grid grid-cols-2 gap-x-6 gap-y-2.5">
            {
              navItems.map((item) => (
                <li>
                  <a href={routeMap[item.key][lang]} class="text-sm font-medium text-graphite transition-colors duration-200 hover:text-blue">
                    {t(item.labelKey)}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>

        <div>
          <h2 class="text-[0.7rem] font-semibold uppercase tracking-[0.12em] text-smoke">{t('contact.title')}</h2>
          <address class="mt-4 space-y-2 text-sm not-italic leading-relaxed text-graphite">
            <p>{contact.addressLines.join(' ')}</p>
            <p><a href={`tel:${contact.phoneHref}`} class="transition-colors hover:text-blue">{contact.phoneDisplay}</a></p>
            <p><a href={`mailto:${contact.email}`} class="font-medium text-blue transition-opacity hover:opacity-70">{contact.email}</a></p>
          </address>
        </div>
      </div>

      <div class="mt-10 border-t border-ash pt-6 text-center text-xs text-smoke">
        &copy; {year} Tüfek &amp; Türkan Hukuk Bürosu. {t('footer.rights')}
      </div>
    </div>
  </div>
</footer>
