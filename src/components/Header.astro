---
import type { Lang } from '../i18n/ui';
import { useTranslations, routeMap } from '../i18n/utils';
import { navItems } from '../data/site';
import LangSwitcher from './LangSwitcher.astro';

interface Props {
  lang: Lang;
  altPath: string;
}

const { lang, altPath } = Astro.props;
const t = useTranslations(lang);
const homeHref = routeMap.home[lang];
const links = navItems.filter((i) => i.key !== 'home');
---

<header class="sticky top-0 z-50 border-b border-line bg-paper/92 backdrop-blur-md" style="z-index: var(--z-header)">
  <div class="mx-auto flex h-[4.5rem] max-w-[78rem] items-center justify-between gap-6 px-6 sm:px-10">
    <a href={homeHref} class="shrink-0" aria-label={t('site.name')}>
      <span class="font-serif text-[1.4rem] font-medium tracking-[0.01em] text-ink">Tüfek &amp; Türkan</span>
    </a>

    <nav class="hidden items-center gap-7 lg:flex" aria-label={t('nav.menu')}>
      {
        links.map((item) => (
          <a
            href={routeMap[item.key][lang]}
            class="text-[1.02rem] text-ink-soft underline-offset-[6px] transition-colors duration-200 hover:text-accent hover:underline"
          >
            {t(item.labelKey)}
          </a>
        ))
      }
      <span class="h-4 w-px bg-line-strong" aria-hidden="true"></span>
      <LangSwitcher lang={lang} altPath={altPath} />
    </nav>

    <div class="flex items-center gap-4 lg:hidden">
      <LangSwitcher lang={lang} altPath={altPath} />
      <button type="button" id="menu-toggle" class="inline-flex h-10 w-10 items-center justify-center text-ink"
        aria-label={t('nav.menu')} aria-expanded="false" aria-controls="mobile-menu">
        <svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="1.4" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" d="M4 8h16M4 16h16" />
        </svg>
      </button>
    </div>
  </div>

  <nav id="mobile-menu" class="hidden border-t border-line bg-paper lg:hidden" aria-label={t('nav.menu')}>
    <ul class="mx-auto max-w-[78rem] px-6 py-2 sm:px-10">
      {
        links.map((item) => (
          <li>
            <a href={routeMap[item.key][lang]} class="block border-b border-line py-3.5 font-serif text-[1.2rem] text-ink transition-colors hover:text-accent">
              {t(item.labelKey)}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  if (toggle && menu) {
    toggle.addEventListener('click', () => {
      const open = menu.classList.toggle('hidden') === false;
      toggle.setAttribute('aria-expanded', String(open));
    });
    menu.querySelectorAll('a').forEach((a) =>
      a.addEventListener('click', () => { menu.classList.add('hidden'); toggle.setAttribute('aria-expanded', 'false'); })
    );
  }
</script>
