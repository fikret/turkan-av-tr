---
import type { Lang } from '../i18n/ui';
import { useTranslations, routeMap } from '../i18n/utils';
import { navItems } from '../data/site';
import LangSwitcher from './LangSwitcher.astro';

interface Props {
  lang: Lang;
  /** Karşı dildeki eş sayfanın yolu (dil değiştirici için). */
  altPath: string;
}

const { lang, altPath } = Astro.props;
const t = useTranslations(lang);
const homeHref = routeMap.home[lang];
---

<header class="sticky top-0 z-50 border-b border-ink/10 bg-white/90 backdrop-blur-md">
  <div class="mx-auto flex h-16 max-w-7xl items-center justify-between px-4 sm:px-6 lg:px-8">
    {/* Wordmark (logo metni) */}
    <a href={homeHref} class="group flex items-center gap-2.5" aria-label={t('site.name')}>
      <span
        class="flex h-9 w-9 items-center justify-center rounded-sm bg-ink font-serif text-base font-semibold text-cream"
        aria-hidden="true">T&amp;T</span>
      <span class="flex flex-col leading-none">
        <span class="font-serif text-lg font-semibold tracking-tight text-ink">Tüfek &amp; Türkan</span>
        <span class="text-[0.62rem] font-medium uppercase tracking-[0.18em] text-gold-600">Hukuk Bürosu</span>
      </span>
    </a>

    {/* Masaüstü menü */}
    <nav class="hidden items-center gap-6 lg:flex" aria-label={t('nav.menu')}>
      {
        navItems.map((item) => (
          <a
            href={routeMap[item.key][lang]}
            class="text-sm font-medium text-ink-500 transition-colors hover:text-gold-600"
          >
            {t(item.labelKey)}
          </a>
        ))
      }
      <LangSwitcher lang={lang} altPath={altPath} />
    </nav>

    {/* Mobil aç/kapa */}
    <div class="flex items-center gap-3 lg:hidden">
      <LangSwitcher lang={lang} altPath={altPath} />
      <button
        type="button"
        id="menu-toggle"
        class="inline-flex h-10 w-10 items-center justify-center rounded-sm text-ink"
        aria-label={t('nav.menu')}
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true">
          <path id="icon-open" stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </div>

  {/* Mobil menü paneli */}
  <nav
    id="mobile-menu"
    class="hidden border-t border-ink/10 bg-white lg:hidden"
    aria-label={t('nav.menu')}
  >
    <ul class="mx-auto max-w-7xl px-4 py-2 sm:px-6">
      {
        navItems.map((item) => (
          <li>
            <a
              href={routeMap[item.key][lang]}
              class="block border-b border-ink/5 py-3 text-base font-medium text-ink-700 transition-colors hover:text-gold-600"
            >
              {t(item.labelKey)}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  if (toggle && menu) {
    toggle.addEventListener('click', () => {
      const open = menu.classList.toggle('hidden') === false;
      toggle.setAttribute('aria-expanded', String(open));
    });
    // Bir bağlantıya tıklanınca menüyü kapat
    menu.querySelectorAll('a').forEach((a) =>
      a.addEventListener('click', () => {
        menu.classList.add('hidden');
        toggle.setAttribute('aria-expanded', 'false');
      })
    );
  }
</script>
