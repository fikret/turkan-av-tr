---
import type { Lang } from '../i18n/ui';
import { useTranslations, routeMap } from '../i18n/utils';
import { navItems } from '../data/site';
import LangSwitcher from './LangSwitcher.astro';

interface Props {
  lang: Lang;
  altPath: string;
}

const { lang, altPath } = Astro.props;
const t = useTranslations(lang);
const homeHref = routeMap.home[lang];
const centerItems = navItems.filter((i) => i.key !== 'contact' && i.key !== 'home');
---

<header
  id="site-header"
  class="fixed inset-x-0 top-0 z-50 transition-colors duration-300"
  style="z-index: var(--z-header)"
  data-transparent="true"
>
  <div class="mx-auto flex max-w-[1280px] items-center justify-between px-5 py-5 sm:px-8">
    <a href={homeHref} class="text-[0.95rem] font-semibold tracking-[0.02em] text-obsidian" aria-label={t('site.name')}>
      TÜFEK &amp; TÜRKAN
    </a>

    <nav class="hidden items-center gap-7 lg:flex" aria-label={t('nav.menu')}>
      {
        centerItems.map((item) => (
          <a href={routeMap[item.key][lang]} class="t-caption text-obsidian underline-offset-4 transition-opacity hover:opacity-60">
            {t(item.labelKey)}
          </a>
        ))
      }
    </nav>

    <div class="hidden items-center gap-5 lg:flex">
      <LangSwitcher lang={lang} altPath={altPath} />
      <a href={routeMap.contact[lang]} class="btn-pill btn-pill-dark px-5 py-2 text-[0.92rem]">
        {t('nav.contact')}
      </a>
    </div>

    {/* Mobil */}
    <div class="flex items-center gap-4 lg:hidden">
      <LangSwitcher lang={lang} altPath={altPath} />
      <button type="button" id="menu-toggle" class="inline-flex h-10 w-10 items-center justify-center text-obsidian"
        aria-label={t('nav.menu')} aria-expanded="false" aria-controls="mobile-menu">
        <svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" d="M4 7h16M4 12h16M4 17h16" />
        </svg>
      </button>
    </div>
  </div>

  <nav id="mobile-menu" class="hidden border-t border-linen bg-paper lg:hidden" aria-label={t('nav.menu')}>
    <ul class="mx-auto max-w-[1280px] px-5 py-2 sm:px-8">
      {
        navItems.map((item) => (
          <li>
            <a href={routeMap[item.key][lang]} class="block border-b border-aluminum py-3 text-[1rem] text-obsidian">
              {t(item.labelKey)}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<script>
  const header = document.getElementById('site-header');
  const onScroll = () => {
    if (!header) return;
    const solid = window.scrollY > 24;
    header.classList.toggle('bg-paper', solid);
    header.classList.toggle('border-b', solid);
    header.classList.toggle('border-linen', solid);
    header.dataset.transparent = solid ? 'false' : 'true';
  };
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  if (toggle && menu) {
    toggle.addEventListener('click', () => {
      const open = menu.classList.toggle('hidden') === false;
      toggle.setAttribute('aria-expanded', String(open));
    });
    menu.querySelectorAll('a').forEach((a) =>
      a.addEventListener('click', () => { menu.classList.add('hidden'); toggle.setAttribute('aria-expanded', 'false'); })
    );
  }
</script>
