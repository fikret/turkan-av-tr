---
import type { Lang } from '../i18n/ui';
import { useTranslations, routeMap } from '../i18n/utils';
import { navItems } from '../data/site';
import LangSwitcher from './LangSwitcher.astro';

interface Props {
  lang: Lang;
  altPath: string;
}

const { lang, altPath } = Astro.props;
const t = useTranslations(lang);
const homeHref = routeMap.home[lang];
---

<div class="fixed inset-x-0 top-0 z-50" style="z-index: var(--z-header)">
  <div class="mx-auto max-w-[1200px] px-4 pt-4 sm:pt-5">
    <nav
      class="flex items-center justify-between gap-4 rounded-[22px] border border-paper bg-paper/85 px-3 py-2 pl-4 backdrop-blur-xl glow-ring"
      aria-label={t('nav.menu')}
    >
      {/* Marka kilidi: gradyan daire + wordmark */}
      <a href={homeHref} class="flex items-center gap-2.5" aria-label={t('site.name')}>
        <span
          class="flex h-9 w-9 items-center justify-center rounded-full text-[0.7rem] font-semibold text-white"
          style="background: linear-gradient(150deg, #4a7ff2 0%, #7b7ed8 60%, #c98ab5 100%);"
          aria-hidden="true">T&amp;T</span>
        <span class="text-[1.05rem] font-semibold tracking-[-0.02em] text-ink">Tüfek &amp; Türkan</span>
      </a>

      {/* Masaüstü linkler */}
      <div class="hidden items-center gap-1 lg:flex">
        {
          navItems.map((item) => (
            <a
              href={routeMap[item.key][lang]}
              class="rounded-full px-3 py-1.5 text-[0.85rem] font-medium text-ink transition-opacity duration-200 hover:opacity-60"
            >
              {t(item.labelKey)}
            </a>
          ))
        }
        <span class="mx-1 h-4 w-px bg-ash-2" aria-hidden="true"></span>
        <LangSwitcher lang={lang} altPath={altPath} />
      </div>

      {/* Mobil */}
      <div class="flex items-center gap-1 lg:hidden">
        <LangSwitcher lang={lang} altPath={altPath} />
        <button
          type="button"
          id="menu-toggle"
          class="ml-1 inline-flex h-9 w-9 items-center justify-center rounded-full text-ink"
          aria-label={t('nav.menu')}
          aria-expanded="false"
          aria-controls="mobile-menu"
        >
          <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" d="M4 7h16M4 12h16M4 17h16" />
          </svg>
        </button>
      </div>
    </nav>

    {/* Mobil panel */}
    <nav
      id="mobile-menu"
      class="mt-2 hidden rounded-[22px] border border-paper bg-paper p-2 glow-ring lg:hidden"
      aria-label={t('nav.menu')}
    >
      <ul>
        {
          navItems.map((item) => (
            <li>
              <a
                href={routeMap[item.key][lang]}
                class="block rounded-2xl px-4 py-2.5 text-[0.95rem] font-medium text-ink transition-colors hover:bg-ash"
              >
                {t(item.labelKey)}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</div>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  if (toggle && menu) {
    toggle.addEventListener('click', () => {
      const open = menu.classList.toggle('hidden') === false;
      toggle.setAttribute('aria-expanded', String(open));
    });
    menu.querySelectorAll('a').forEach((a) =>
      a.addEventListener('click', () => {
        menu.classList.add('hidden');
        toggle.setAttribute('aria-expanded', 'false');
      })
    );
  }
</script>
