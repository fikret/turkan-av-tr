---
import { Image } from 'astro:assets';
import type { Lang } from '../i18n/ui';
import { useTranslations, routeMap } from '../i18n/utils';
import { team } from '../data/team';

interface Props {
  lang: Lang;
  /** true: tam biyografiler (Ekibimiz sayfası). false: ana sayfa (foto + isim + ünvan). */
  full?: boolean;
}

const { lang, full = false } = Astro.props;
const t = useTranslations(lang);

function initials(name: string): string {
  const parts = name.replace(/^Av\.\s*|^Arb\.\s*/g, '').trim().split(/\s+/);
  return ((parts[0]?.[0] ?? '') + (parts[parts.length - 1]?.[0] ?? '')).toUpperCase();
}
---

<section id="ekibimiz" class={full ? 'bg-paper' : 'bg-forest-deep'}>
  <div class="mx-auto max-w-[78rem] px-5 py-24 sm:px-8 lg:py-32">
    <div class="max-w-2xl">
      <h2 class={`t-h2 ${full ? 'text-forest' : 'text-cream'}`}>{t('team.title')}</h2>
      <div class="rule-brass mt-7 w-20"></div>
      <p class={`t-lead mt-7 prose-measure ${full ? 'text-ink-soft' : 'text-cream-soft'}`}>{t('team.subtitle')}</p>
    </div>

    {/* Ana sayfa: foto + isim + ünvan (koyu yeşil zemin) */}
    {
      !full && (
        <>
          <div class="mt-14 grid grid-cols-2 gap-x-6 gap-y-10 sm:grid-cols-3 lg:grid-cols-4">
            {team.map((m) => (
              <a
                href={`${routeMap.team[lang]}#${m.slug}`}
                class="group block"
                aria-label={`${m.name} — ${m.title[lang]}`}
              >
                <div class="relative aspect-[4/5] w-full overflow-hidden bg-forest-900">
                  {m.photo ? (
                    <Image
                      src={m.photo}
                      alt={m.name}
                      widths={[240, 360, 480]}
                      sizes="(max-width: 640px) 45vw, (max-width: 1024px) 30vw, 240px"
                      class="h-full w-full object-cover object-top opacity-95 transition-all duration-500 group-hover:scale-[1.03] group-hover:opacity-100"
                    />
                  ) : (
                    <div class="flex h-full w-full items-center justify-center bg-forest-700 text-cream">
                      <span class="font-serif text-4xl">{initials(m.name)}</span>
                    </div>
                  )}
                  <span class="absolute inset-x-0 bottom-0 h-px scale-x-0 bg-brass transition-transform duration-500 group-hover:scale-x-100" aria-hidden="true"></span>
                </div>
                <p class="mt-4 font-serif text-[1.2rem] leading-snug text-cream transition-colors duration-300 group-hover:text-brass">
                  {m.name}
                </p>
                <p class="mt-1 text-[0.8rem] leading-snug text-cream-soft">{m.title[lang]}</p>
              </a>
            ))}
          </div>
          <div class="mt-12">
            <a
              href={routeMap.team[lang]}
              class="group inline-flex items-center gap-2 text-sm font-semibold text-brass transition-colors duration-300 hover:text-cream"
            >
              {t('team.all')}
              <span class="transition-transform duration-300 group-hover:translate-x-1" aria-hidden="true">&rarr;</span>
            </a>
          </div>
        </>
      )
    }

    {/* Ekibimiz sayfası: tam biyografiler */}
    {
      full && (
        <div class="mt-16 space-y-16">
          {team.map((m) => (
            <article class="scroll-mt-28 grid gap-8 border-t border-line pt-16 first:border-t-0 first:pt-0 md:grid-cols-12 md:gap-10" id={m.slug}>
              <div class="md:col-span-4 lg:col-span-3">
                <div class="relative aspect-[4/5] w-full max-w-[240px] overflow-hidden bg-forest-900">
                  {m.photo ? (
                    <Image
                      src={m.photo}
                      alt={m.name}
                      widths={[240, 360, 480]}
                      sizes="(max-width: 768px) 60vw, 240px"
                      class="h-full w-full object-cover object-top"
                    />
                  ) : (
                    <div class="flex h-full w-full items-center justify-center bg-forest-700 text-cream">
                      <span class="font-serif text-5xl">{initials(m.name)}</span>
                    </div>
                  )}
                </div>
              </div>
              <div class="md:col-span-8 lg:col-span-9">
                <h2 class="font-serif text-[1.85rem] leading-tight text-forest">{m.name}</h2>
                <p class="mt-1.5 text-sm font-semibold uppercase tracking-[0.1em] text-brass-deep">{m.title[lang]}</p>
                <p class="mt-2.5 text-sm">
                  <a href={`mailto:${m.email}`} class="text-ink-soft underline-offset-4 transition-colors hover:text-brass-deep hover:underline">
                    {m.email}
                  </a>
                </p>

                <dl class="mt-7 grid gap-7 sm:grid-cols-2">
                  {m.areas.length > 0 && (
                    <div class="sm:col-span-2">
                      <dt class="t-eyebrow text-ink-faint">{t('team.areas')}</dt>
                      <dd class="mt-3 flex flex-wrap gap-x-2 gap-y-2">
                        {m.areas.map((a) => (
                          <span class="border border-line px-3 py-1 text-[0.8rem] text-ink-soft">{a[lang]}</span>
                        ))}
                      </dd>
                    </div>
                  )}
                  {m.education.length > 0 && (
                    <div>
                      <dt class="t-eyebrow text-ink-faint">{t('team.education')}</dt>
                      <dd class="mt-3 space-y-1.5 text-[0.95rem] text-ink-soft">
                        {m.education.map((e) => (
                          <p>{e[lang]}</p>
                        ))}
                      </dd>
                    </div>
                  )}
                  <div>
                    <dt class="t-eyebrow text-ink-faint">{t('team.languages')}</dt>
                    <dd class="mt-3 text-[0.95rem] text-ink-soft">{m.languages[lang]}</dd>
                    {m.bar && (
                      <>
                        <dt class="t-eyebrow mt-5 text-ink-faint">{m.bar.label[lang]}</dt>
                        <dd class="mt-3 text-[0.95rem] text-ink-soft">{m.bar.value}</dd>
                      </>
                    )}
                  </div>
                </dl>
              </div>
            </article>
          ))}
        </div>
      )
    }
  </div>
</section>
