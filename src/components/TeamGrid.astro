---
import { Image } from 'astro:assets';
import type { Lang } from '../i18n/ui';
import { useTranslations, routeMap } from '../i18n/utils';
import { team } from '../data/team';

interface Props {
  lang: Lang;
  full?: boolean;
}

const { lang, full = false } = Astro.props;
const t = useTranslations(lang);

function initials(name: string): string {
  const parts = name.replace(/^Av\.\s*|^Arb\.\s*/g, '').trim().split(/\s+/);
  return ((parts[0]?.[0] ?? '') + (parts[parts.length - 1]?.[0] ?? '')).toUpperCase();
}
---

<section id="ekibimiz" class="border-t border-line bg-paper-2">
  <div class="mx-auto max-w-[78rem] px-6 py-20 sm:px-10 sm:py-28">
    <h2 class="t-h2 text-ink">{t('team.title')}</h2>
    <div class="rule mt-8"></div>

    {
      !full && (
        <>
          <div class="mt-12 grid grid-cols-2 gap-x-8 gap-y-12 sm:grid-cols-3 lg:grid-cols-4">
            {team.map((m) => (
              <a href={`${routeMap.team[lang]}#${m.slug}`} class="group block" aria-label={`${m.name} — ${m.title[lang]}`}>
                <div class="relative aspect-[4/5] w-full overflow-hidden bg-paper-3">
                  {m.photo ? (
                    <Image src={m.photo} alt={m.name} widths={[240, 360, 480]}
                      sizes="(max-width: 640px) 45vw, (max-width: 1024px) 30vw, 240px"
                      class="grade-warm h-full w-full object-cover object-top transition-transform duration-500 group-hover:scale-[1.03]" />
                  ) : (
                    <div class="flex h-full w-full items-center justify-center bg-paper-3 text-ink-faint">
                      <span class="font-serif text-4xl">{initials(m.name)}</span>
                    </div>
                  )}
                </div>
                <p class="mt-4 font-serif text-[1.25rem] leading-snug text-ink transition-colors duration-200 group-hover:text-accent">{m.name}</p>
                <p class="t-label mt-0.5 leading-snug">{m.title[lang]}</p>
              </a>
            ))}
          </div>
          <div class="mt-12">
            <a href={routeMap.team[lang]} class="inline-flex items-center gap-2 text-[1.02rem] text-accent underline underline-offset-[6px] transition-opacity hover:opacity-70">
              {t('team.all')}<span aria-hidden="true">&rarr;</span>
            </a>
          </div>
        </>
      )
    }

    {
      full && (
        <div class="mt-4 space-y-12">
          {team.map((m) => (
            <article id={m.slug} class="scroll-mt-28 grid gap-7 border-t border-line pt-12 first:border-t-0 first:pt-0 md:grid-cols-12 md:gap-10">
              <div class="md:col-span-3">
                <div class="aspect-[4/5] w-full max-w-[230px] overflow-hidden bg-paper-3">
                  {m.photo ? (
                    <Image src={m.photo} alt={m.name} widths={[240, 360, 480]} sizes="(max-width: 768px) 60vw, 230px"
                      class="grade-warm h-full w-full object-cover object-top" />
                  ) : (
                    <div class="flex h-full w-full items-center justify-center bg-paper-3 text-ink-faint">
                      <span class="font-serif text-5xl">{initials(m.name)}</span>
                    </div>
                  )}
                </div>
              </div>
              <div class="md:col-span-9">
                <h3 class="font-serif text-[1.7rem] font-medium text-ink">{m.name}</h3>
                <p class="t-label mt-1.5 text-accent-soft">{m.title[lang]}</p>
                <p class="mt-2 text-[1rem]">
                  <a href={`mailto:${m.email}`} class="text-ink-soft underline underline-offset-4 transition-colors hover:text-accent">{m.email}</a>
                </p>
                <dl class="mt-6 grid gap-x-12 gap-y-6 sm:grid-cols-2">
                  {m.areas.length > 0 && (
                    <div class="sm:col-span-2">
                      <dt class="t-label">{t('team.areas')}</dt>
                      <dd class="mt-2 text-[0.98rem] leading-relaxed text-ink-soft">{m.areas.map((a) => a[lang]).join(' · ')}</dd>
                    </div>
                  )}
                  {m.education.length > 0 && (
                    <div>
                      <dt class="t-label">{t('team.education')}</dt>
                      <dd class="mt-2 space-y-1 text-[0.98rem] text-ink-soft">{m.education.map((e) => <p>{e[lang]}</p>)}</dd>
                    </div>
                  )}
                  <div>
                    <dt class="t-label">{t('team.languages')}</dt>
                    <dd class="mt-2 text-[0.98rem] text-ink-soft">{m.languages[lang]}</dd>
                    {m.bar && (
                      <>
                        <dt class="t-label mt-4">{m.bar.label[lang]}</dt>
                        <dd class="mt-2 text-[0.98rem] text-ink-soft">{m.bar.value}</dd>
                      </>
                    )}
                  </div>
                </dl>
              </div>
            </article>
          ))}
        </div>
      )
    }
  </div>
</section>
