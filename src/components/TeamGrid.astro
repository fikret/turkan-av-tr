---
import { Image } from 'astro:assets';
import type { Lang } from '../i18n/ui';
import { useTranslations, routeMap } from '../i18n/utils';
import { team } from '../data/team';

interface Props {
  lang: Lang;
  full?: boolean;
}

const { lang, full = false } = Astro.props;
const t = useTranslations(lang);

function initials(name: string): string {
  const parts = name.replace(/^Av\.\s*|^Arb\.\s*/g, '').trim().split(/\s+/);
  return ((parts[0]?.[0] ?? '') + (parts[parts.length - 1]?.[0] ?? '')).toUpperCase();
}
---

<section id="ekibimiz" class={full ? 'bg-ash py-[80px] sm:py-[100px]' : 'bg-ash py-[88px] sm:py-[110px]'}>
  <div class="mx-auto max-w-[1100px] px-5 sm:px-8">
    <div class="text-center">
      <h2 class="t-h2 text-ink">{t('team.title')}</h2>
      <p class="mx-auto mt-4 max-w-[44ch] text-[1.1rem] leading-relaxed text-smoke">{t('team.subtitle')}</p>
    </div>

    {/* Ana sayfa: çerçeveli portreler */}
    {
      !full && (
        <>
          <div class="mt-12 grid grid-cols-2 gap-5 sm:grid-cols-3 lg:grid-cols-4">
            {team.map((m) => (
              <a
                href={`${routeMap.team[lang]}#${m.slug}`}
                class="group block text-center"
                aria-label={`${m.name} — ${m.title[lang]}`}
              >
                <div class="rounded-[24px] bg-paper p-1.5 glow-ring transition-transform duration-300 group-hover:-translate-y-1">
                  {m.photo ? (
                    <Image
                      src={m.photo}
                      alt={m.name}
                      widths={[240, 360, 480]}
                      sizes="(max-width: 640px) 45vw, (max-width: 1024px) 30vw, 240px"
                      class="aspect-[4/5] w-full rounded-[18px] object-cover object-top"
                    />
                  ) : (
                    <div class="flex aspect-[4/5] w-full items-center justify-center rounded-[18px] bg-ash">
                      <span class="font-display text-4xl text-smoke">{initials(m.name)}</span>
                    </div>
                  )}
                </div>
                <p class="mt-4 font-display text-[1.2rem] text-ink transition-colors duration-200 group-hover:text-blue">
                  {m.name}
                </p>
                <p class="mt-1 text-[0.82rem] leading-snug text-smoke">{m.title[lang]}</p>
              </a>
            ))}
          </div>
          <div class="mt-10 text-center">
            <a
              href={routeMap.team[lang]}
              class="inline-flex items-center gap-1.5 text-[0.95rem] font-semibold text-blue transition-opacity duration-200 hover:opacity-70"
            >
              {t('team.all')}
              <span aria-hidden="true">&rarr;</span>
            </a>
          </div>
        </>
      )
    }

    {/* Ekibimiz sayfası: tam biyografiler */}
    {
      full && (
        <div class="mx-auto mt-14 max-w-[1000px] space-y-12">
          {team.map((m) => (
            <article id={m.slug} class="scroll-mt-28 rounded-[28px] bg-paper p-5 glow-ring sm:p-7">
              <div class="grid gap-6 md:grid-cols-12 md:gap-8">
                <div class="md:col-span-4 lg:col-span-3">
                  {m.photo ? (
                    <Image
                      src={m.photo}
                      alt={m.name}
                      widths={[240, 360, 480]}
                      sizes="(max-width: 768px) 60vw, 240px"
                      class="aspect-[4/5] w-full max-w-[230px] rounded-[20px] object-cover object-top"
                    />
                  ) : (
                    <div class="flex aspect-[4/5] w-full max-w-[230px] items-center justify-center rounded-[20px] bg-ash">
                      <span class="font-display text-5xl text-smoke">{initials(m.name)}</span>
                    </div>
                  )}
                </div>
                <div class="md:col-span-8 lg:col-span-9">
                  <h2 class="font-display text-[1.7rem] text-ink">{m.name}</h2>
                  <p class="mt-1.5 text-[0.9rem] font-medium text-smoke">{m.title[lang]}</p>
                  <p class="mt-2 text-sm">
                    <a href={`mailto:${m.email}`} class="font-medium text-blue transition-opacity hover:opacity-70">
                      {m.email}
                    </a>
                  </p>

                  <dl class="mt-6 grid gap-6 sm:grid-cols-2">
                    {m.areas.length > 0 && (
                      <div class="sm:col-span-2">
                        <dt class="text-[0.7rem] font-semibold uppercase tracking-[0.1em] text-smoke">{t('team.areas')}</dt>
                        <dd class="mt-2.5 flex flex-wrap gap-2">
                          {m.areas.map((a) => (
                            <span class="pill bg-ash px-3 py-1 text-[0.8rem] text-graphite">{a[lang]}</span>
                          ))}
                        </dd>
                      </div>
                    )}
                    {m.education.length > 0 && (
                      <div>
                        <dt class="text-[0.7rem] font-semibold uppercase tracking-[0.1em] text-smoke">{t('team.education')}</dt>
                        <dd class="mt-2.5 space-y-1.5 text-[0.92rem] text-graphite">
                          {m.education.map((e) => (
                            <p>{e[lang]}</p>
                          ))}
                        </dd>
                      </div>
                    )}
                    <div>
                      <dt class="text-[0.7rem] font-semibold uppercase tracking-[0.1em] text-smoke">{t('team.languages')}</dt>
                      <dd class="mt-2.5 text-[0.92rem] text-graphite">{m.languages[lang]}</dd>
                      {m.bar && (
                        <>
                          <dt class="mt-4 text-[0.7rem] font-semibold uppercase tracking-[0.1em] text-smoke">{m.bar.label[lang]}</dt>
                          <dd class="mt-2.5 text-[0.92rem] text-graphite">{m.bar.value}</dd>
                        </>
                      )}
                    </div>
                  </dl>
                </div>
              </div>
            </article>
          ))}
        </div>
      )
    }
  </div>
</section>
