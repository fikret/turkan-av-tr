---
import { Image } from 'astro:assets';
import type { Lang } from '../i18n/ui';
import { useTranslations, routeMap } from '../i18n/utils';
import { team } from '../data/team';

interface Props {
  lang: Lang;
  full?: boolean;
}

const { lang, full = false } = Astro.props;
const t = useTranslations(lang);

function initials(name: string): string {
  const parts = name.replace(/^Av\.\s*|^Arb\.\s*/g, '').trim().split(/\s+/);
  return ((parts[0]?.[0] ?? '') + (parts[parts.length - 1]?.[0] ?? '')).toUpperCase();
}
---

<section id="ekibimiz" class="bg-paper">
  <div class="mx-auto max-w-[1280px] px-5 py-[88px] sm:px-8 sm:py-[110px]">
    {
      !full && (
        <div class="grid gap-8 lg:grid-cols-12 lg:gap-6">
          <div class="lg:col-span-3"><p class="t-caption text-obsidian">{t('team.title')}</p></div>
          <div class="lg:col-span-9 lg:pl-10"><h2 class="t-h max-w-[20ch] text-obsidian">{t('team.subtitle')}</h2></div>
        </div>
      )
    }

    {/* Ana sayfa: gri-tonlama portreler */}
    {
      !full && (
        <>
          <div class="mt-12 grid grid-cols-2 gap-5 sm:grid-cols-3 lg:grid-cols-4">
            {team.map((m) => (
              <a href={`${routeMap.team[lang]}#${m.slug}`} class="group block" aria-label={`${m.name} — ${m.title[lang]}`}>
                <div class="overflow-hidden rounded-[8px] border border-linen bg-graphite">
                  {m.photo ? (
                    <Image
                      src={m.photo}
                      alt={m.name}
                      widths={[240, 360, 480]}
                      sizes="(max-width: 640px) 45vw, (max-width: 1024px) 30vw, 240px"
                      class="grayscale-img aspect-[4/5] w-full object-cover object-top transition-transform duration-500 group-hover:scale-[1.02]"
                    />
                  ) : (
                    <div class="flex aspect-[4/5] w-full items-center justify-center bg-graphite">
                      <span class="text-4xl font-medium text-paper/85">{initials(m.name)}</span>
                    </div>
                  )}
                </div>
                <p class="mt-3 text-[1.05rem] font-medium leading-snug text-obsidian underline-offset-4 group-hover:underline">{m.name}</p>
                <p class="t-caption mt-0.5 leading-snug text-muted">{m.title[lang]}</p>
              </a>
            ))}
          </div>
          <div class="mt-10">
            <a href={routeMap.team[lang]} class="btn-sq inline-flex items-center gap-2 px-5 py-2.5 text-[0.95rem]">
              {t('team.all')}
              <span aria-hidden="true">&rarr;</span>
            </a>
          </div>
        </>
      )
    }

    {/* Ekibimiz sayfası: tam biyografiler */}
    {
      full && (
        <div class="space-y-8">
          {team.map((m) => (
            <article id={m.slug} class="scroll-mt-28 grid gap-6 border-t border-obsidian pt-8 first:border-t-0 first:pt-0 md:grid-cols-12 md:gap-8">
              <div class="md:col-span-4 lg:col-span-3">
                <div class="overflow-hidden rounded-[8px] border border-linen bg-graphite">
                  {m.photo ? (
                    <Image
                      src={m.photo}
                      alt={m.name}
                      widths={[240, 360, 480]}
                      sizes="(max-width: 768px) 60vw, 240px"
                      class="grayscale-img aspect-[4/5] w-full max-w-[240px] object-cover object-top"
                    />
                  ) : (
                    <div class="flex aspect-[4/5] w-full max-w-[240px] items-center justify-center bg-graphite">
                      <span class="text-5xl font-medium text-paper/85">{initials(m.name)}</span>
                    </div>
                  )}
                </div>
              </div>
              <div class="md:col-span-8 lg:col-span-9">
                <h2 class="t-hsm text-obsidian">{m.name}</h2>
                <p class="t-caption mt-1.5 text-muted">{m.title[lang]}</p>
                <p class="t-caption mt-2">
                  <a href={`mailto:${m.email}`} class="text-obsidian underline underline-offset-4 hover:opacity-60">{m.email}</a>
                </p>

                <dl class="mt-6 grid gap-6 sm:grid-cols-2">
                  {m.areas.length > 0 && (
                    <div class="sm:col-span-2">
                      <dt class="t-caption text-muted">{t('team.areas')}</dt>
                      <dd class="mt-2.5 flex flex-wrap gap-2">
                        {m.areas.map((a) => (
                          <span class="rounded-[8px] border border-aluminum px-3 py-1 text-[0.85rem] text-obsidian">{a[lang]}</span>
                        ))}
                      </dd>
                    </div>
                  )}
                  {m.education.length > 0 && (
                    <div>
                      <dt class="t-caption text-muted">{t('team.education')}</dt>
                      <dd class="mt-2.5 space-y-1.5 text-[0.95rem] text-obsidian/90">
                        {m.education.map((e) => (<p>{e[lang]}</p>))}
                      </dd>
                    </div>
                  )}
                  <div>
                    <dt class="t-caption text-muted">{t('team.languages')}</dt>
                    <dd class="mt-2.5 text-[0.95rem] text-obsidian/90">{m.languages[lang]}</dd>
                    {m.bar && (
                      <>
                        <dt class="t-caption mt-4 text-muted">{m.bar.label[lang]}</dt>
                        <dd class="mt-2.5 text-[0.95rem] text-obsidian/90">{m.bar.value}</dd>
                      </>
                    )}
                  </div>
                </dl>
              </div>
            </article>
          ))}
        </div>
      )
    }
  </div>
</section>
