---
import { Image } from 'astro:assets';
import type { Lang } from '../i18n/ui';
import { useTranslations, routeMap } from '../i18n/utils';
import { team } from '../data/team';

interface Props {
  lang: Lang;
  /** true: tam biyografiler (Ekibimiz sayfası). false: ana sayfa (yalnız foto + isim + ünvan). */
  full?: boolean;
}

const { lang, full = false } = Astro.props;
const t = useTranslations(lang);

function initials(name: string): string {
  const parts = name.replace(/^Av\.\s*|^Arb\.\s*/g, '').trim().split(/\s+/);
  return ((parts[0]?.[0] ?? '') + (parts[parts.length - 1]?.[0] ?? '')).toUpperCase();
}
---

<section id="ekibimiz" class="bg-cream">
  <div class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8 lg:py-28">
    <div class="max-w-2xl">
      <p class="text-sm font-semibold uppercase tracking-[0.18em] text-gold-600">
        {t('team.title')}
      </p>
      <h2 class="mt-3 font-serif text-3xl font-semibold leading-tight text-ink sm:text-4xl">
        {t('team.subtitle')}
      </h2>
    </div>

    {/* Ana sayfa: sadece foto + isim + ünvan */}
    {
      !full && (
        <>
          <div class="mt-12 grid grid-cols-2 gap-6 sm:grid-cols-3 lg:grid-cols-4">
            {team.map((m) => (
              <a
                href={`${routeMap.team[lang]}#${m.slug}`}
                class="group block text-center"
                aria-label={`${m.name} — ${m.title[lang]}`}
              >
                <div class="relative mx-auto aspect-[3/4] w-full overflow-hidden rounded-md bg-ink/5 ring-gold/0 transition-shadow group-hover:ring-2 group-hover:ring-gold/40">
                  {m.photo ? (
                    <Image
                      src={m.photo}
                      alt={m.name}
                      widths={[240, 360, 480]}
                      sizes="(max-width: 640px) 45vw, (max-width: 1024px) 30vw, 240px"
                      class="h-full w-full object-cover object-top transition-transform duration-500 group-hover:scale-[1.03]"
                    />
                  ) : (
                    <div class="flex h-full w-full items-center justify-center bg-ink text-cream">
                      <span class="font-serif text-3xl font-semibold tracking-wide">{initials(m.name)}</span>
                    </div>
                  )}
                </div>
                <div class="mt-3">
                  <p class="font-serif text-lg font-semibold leading-snug text-ink transition-colors group-hover:text-gold-600">{m.name}</p>
                  <p class="mt-0.5 text-xs leading-snug text-gold-600">{m.title[lang]}</p>
                </div>
              </a>
            ))}
          </div>
          <div class="mt-10">
            <a
              href={routeMap.team[lang]}
              class="inline-flex items-center gap-2 text-sm font-semibold text-gold-600 transition-colors hover:text-ink"
            >
              {t('team.all')}
              <span aria-hidden="true">&rarr;</span>
            </a>
          </div>
        </>
      )
    }

    {/* Ekibimiz sayfası: tam biyografiler */}
    {
      full && (
        <div class="mt-12 space-y-12">
          {team.map((m) => (
            <article id={m.slug} class="scroll-mt-24 grid gap-6 border-t border-ink/10 pt-12 first:border-t-0 first:pt-0 md:grid-cols-12 md:gap-8">
              <div class="md:col-span-3">
                <div class="relative aspect-[3/4] w-full max-w-[220px] overflow-hidden rounded-md bg-ink/5">
                  {m.photo ? (
                    <Image
                      src={m.photo}
                      alt={m.name}
                      widths={[220, 360, 440]}
                      sizes="(max-width: 768px) 60vw, 220px"
                      class="h-full w-full object-cover object-top"
                    />
                  ) : (
                    <div class="flex h-full w-full items-center justify-center bg-ink text-cream">
                      <span class="font-serif text-4xl font-semibold tracking-wide">{initials(m.name)}</span>
                    </div>
                  )}
                </div>
              </div>
              <div class="md:col-span-9">
                <h2 class="font-serif text-2xl font-semibold text-ink">{m.name}</h2>
                <p class="mt-1 text-sm font-medium text-gold-600">{m.title[lang]}</p>
                <p class="mt-2 text-sm">
                  <a href={`mailto:${m.email}`} class="text-ink-500 underline-offset-2 transition-colors hover:text-gold-600 hover:underline">
                    {m.email}
                  </a>
                </p>

                <dl class="mt-6 grid gap-6 sm:grid-cols-2">
                  {m.areas.length > 0 && (
                    <div class="sm:col-span-2">
                      <dt class="text-xs font-semibold uppercase tracking-wide text-ink-500">{t('team.areas')}</dt>
                      <dd class="mt-2 flex flex-wrap gap-2">
                        {m.areas.map((a) => (
                          <span class="rounded-full bg-white px-3 py-1 text-xs text-ink-700 ring-1 ring-ink/10">{a[lang]}</span>
                        ))}
                      </dd>
                    </div>
                  )}
                  {m.education.length > 0 && (
                    <div>
                      <dt class="text-xs font-semibold uppercase tracking-wide text-ink-500">{t('team.education')}</dt>
                      <dd class="mt-2 space-y-1 text-sm text-ink-700">
                        {m.education.map((e) => (
                          <p>{e[lang]}</p>
                        ))}
                      </dd>
                    </div>
                  )}
                  <div>
                    <dt class="text-xs font-semibold uppercase tracking-wide text-ink-500">{t('team.languages')}</dt>
                    <dd class="mt-2 text-sm text-ink-700">{m.languages[lang]}</dd>
                    {m.bar && (
                      <>
                        <dt class="mt-4 text-xs font-semibold uppercase tracking-wide text-ink-500">{m.bar.label[lang]}</dt>
                        <dd class="mt-2 text-sm text-ink-700">{m.bar.value}</dd>
                      </>
                    )}
                  </div>
                </dl>
              </div>
            </article>
          ))}
        </div>
      )
    }
  </div>
</section>
