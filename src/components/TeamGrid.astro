---
import { Image } from 'astro:assets';
import type { Lang } from '../i18n/ui';
import { useTranslations, routeMap } from '../i18n/utils';
import { team } from '../data/team';

interface Props {
  lang: Lang;
  full?: boolean;
}

const { lang, full = false } = Astro.props;
const t = useTranslations(lang);

function initials(name: string): string {
  const parts = name.replace(/^Av\.\s*|^Arb\.\s*/g, '').trim().split(/\s+/);
  return ((parts[0]?.[0] ?? '') + (parts[parts.length - 1]?.[0] ?? '')).toUpperCase();
}
---

<section id="ekibimiz" class="bg-cream">
  <div class="mx-auto max-w-[1200px] px-5 py-20 sm:px-8 sm:py-24 lg:py-28">
    <div class="max-w-[44rem]">
      <p class="t-mono-label text-ink/70">{t('team.title')}</p>
      <h2 class="t-h2 mt-4 text-ink">{t('team.subtitle')}</h2>
    </div>

    {/* Ana sayfa: çerçeveli portreler */}
    {
      !full && (
        <>
          <div class="mt-12 grid grid-cols-2 gap-6 sm:grid-cols-3 lg:grid-cols-4">
            {team.map((m) => (
              <a href={`${routeMap.team[lang]}#${m.slug}`} class="group block" aria-label={`${m.name} — ${m.title[lang]}`}>
                <div class="frame relative bg-white">
                  {m.photo ? (
                    <Image
                      src={m.photo}
                      alt={m.name}
                      widths={[240, 360, 480]}
                      sizes="(max-width: 640px) 45vw, (max-width: 1024px) 30vw, 240px"
                      class="aspect-[4/5] w-full object-cover object-top"
                    />
                  ) : (
                    <div class="flex aspect-[4/5] w-full items-center justify-center bg-cream">
                      <span class="text-4xl font-bold text-ink/40">{initials(m.name)}</span>
                    </div>
                  )}
                  <span class="absolute right-2 top-2 h-3 w-3 bg-butter opacity-0 ring-1 ring-ink transition-opacity duration-150 group-hover:opacity-100" aria-hidden="true"></span>
                </div>
                <p class="mt-3 text-[1.05rem] font-bold leading-snug text-ink underline-offset-4 group-hover:underline">{m.name}</p>
                <p class="mt-0.5 text-[0.82rem] leading-snug text-ink/70">{m.title[lang]}</p>
              </a>
            ))}
          </div>
          <div class="mt-10">
            <a href={routeMap.team[lang]} class="btn-ghost inline-flex items-center gap-2 px-5 py-2.5 text-[0.9rem] font-medium">
              {t('team.all')}
              <span aria-hidden="true">&rarr;</span>
            </a>
          </div>
        </>
      )
    }

    {/* Ekibimiz sayfası: tam biyografiler */}
    {
      full && (
        <div class="mt-12 space-y-8">
          {team.map((m) => (
            <article id={m.slug} class="frame scroll-mt-28 bg-white">
              <div class="grid gap-6 p-6 md:grid-cols-12 md:gap-8 md:p-8">
                <div class="md:col-span-4 lg:col-span-3">
                  {m.photo ? (
                    <Image
                      src={m.photo}
                      alt={m.name}
                      widths={[240, 360, 480]}
                      sizes="(max-width: 768px) 60vw, 240px"
                      class="frame aspect-[4/5] w-full max-w-[230px] object-cover object-top"
                    />
                  ) : (
                    <div class="frame flex aspect-[4/5] w-full max-w-[230px] items-center justify-center bg-cream">
                      <span class="text-5xl font-bold text-ink/40">{initials(m.name)}</span>
                    </div>
                  )}
                </div>
                <div class="md:col-span-8 lg:col-span-9">
                  <h2 class="text-[1.7rem] font-bold leading-tight text-ink">{m.name}</h2>
                  <p class="t-mono-label mt-2 text-ink/70">{m.title[lang]}</p>
                  <p class="mt-2 text-[0.95rem]">
                    <a href={`mailto:${m.email}`} class="font-medium text-ink underline underline-offset-4 hover:bg-butter">{m.email}</a>
                  </p>

                  <dl class="mt-6 grid gap-6 sm:grid-cols-2">
                    {m.areas.length > 0 && (
                      <div class="sm:col-span-2">
                        <dt class="t-mono-label text-ink/60">{t('team.areas')}</dt>
                        <dd class="mt-3 flex flex-wrap gap-2">
                          {m.areas.map((a) => (
                            <span class="border border-ink px-3 py-1 text-[0.82rem] text-ink">{a[lang]}</span>
                          ))}
                        </dd>
                      </div>
                    )}
                    {m.education.length > 0 && (
                      <div>
                        <dt class="t-mono-label text-ink/60">{t('team.education')}</dt>
                        <dd class="mt-3 space-y-1.5 text-[0.95rem] text-ink/85">
                          {m.education.map((e) => (
                            <p>{e[lang]}</p>
                          ))}
                        </dd>
                      </div>
                    )}
                    <div>
                      <dt class="t-mono-label text-ink/60">{t('team.languages')}</dt>
                      <dd class="mt-3 text-[0.95rem] text-ink/85">{m.languages[lang]}</dd>
                      {m.bar && (
                        <>
                          <dt class="t-mono-label mt-4 text-ink/60">{m.bar.label[lang]}</dt>
                          <dd class="mt-3 text-[0.95rem] text-ink/85">{m.bar.value}</dd>
                        </>
                      )}
                    </div>
                  </dl>
                </div>
              </div>
            </article>
          ))}
        </div>
      )
    }
  </div>
</section>
