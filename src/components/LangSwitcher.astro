---
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  altPath: string;
}

const { lang, altPath } = Astro.props;
const other: Lang = lang === 'tr' ? 'en' : 'tr';
const label = other.toUpperCase();
const fullLabel = other === 'tr' ? 'Türkçe' : 'English';
---

<a
  href={altPath}
  hreflang={other}
  lang={other}
  class="pill px-3 py-1.5 text-[0.8rem] font-semibold text-ink transition-colors duration-200 hover:bg-ash"
  aria-label={fullLabel}
>
  {label}
</a>
