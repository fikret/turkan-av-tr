---
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  altPath: string;
}

const { lang, altPath } = Astro.props;
const other: Lang = lang === 'tr' ? 'en' : 'tr';
const label = other.toUpperCase();
const fullLabel = other === 'tr' ? 'Türkçe' : 'English';
---

<a
  href={altPath}
  hreflang={other}
  lang={other}
  class="text-[0.95rem] tracking-[0.04em] text-ink-faint underline-offset-4 transition-colors duration-200 hover:text-accent hover:underline"
  aria-label={fullLabel}
>
  {label}
</a>
