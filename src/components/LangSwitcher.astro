---
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  altPath: string;
}

const { lang, altPath } = Astro.props;
const other: Lang = lang === 'tr' ? 'en' : 'tr';
const label = other.toUpperCase();
const fullLabel = other === 'tr' ? 'Türkçe' : 'English';
---

<a
  href={altPath}
  hreflang={other}
  lang={other}
  class="t-mono-label px-2 py-1 text-ink underline-offset-4 transition-colors hover:underline"
  aria-label={fullLabel}
>
  {label}
</a>
