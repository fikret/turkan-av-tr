---
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  altPath: string;
}

const { lang, altPath } = Astro.props;
const other: Lang = lang === 'tr' ? 'en' : 'tr';
const label = other.toUpperCase();
const fullLabel = other === 'tr' ? 'Türkçe' : 'English';
---

<a
  href={altPath}
  hreflang={other}
  lang={other}
  class="text-[0.78rem] font-semibold uppercase tracking-[0.12em] text-ink-faint transition-colors duration-300 hover:text-brass-deep"
  aria-label={fullLabel}
>
  {label}
</a>
