---
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';
import { contact } from '../data/site';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const rows = [
  { label: t('contact.address'), value: contact.addressLines.join('\n'), kind: 'text' as const },
  { label: t('contact.phone'), value: contact.phoneDisplay, href: `tel:${contact.phoneHref}`, kind: 'link' as const },
  { label: t('contact.email'), value: contact.email, href: `mailto:${contact.email}`, kind: 'link' as const },
];
---

<section id="iletisim" class="bg-ash py-[88px] sm:py-[110px]">
  <div class="mx-auto max-w-[1100px] px-5 sm:px-8">
    <div class="text-center">
      <h2 class="t-h2 text-ink">{t('contact.title')}</h2>
      <p class="mx-auto mt-4 max-w-[40ch] text-[1.1rem] leading-relaxed text-smoke">{t('contact.subtitle')}</p>
    </div>

    <div class="mt-12 grid gap-6 lg:grid-cols-5">
      {/* Bilgiler kartı */}
      <div class="rounded-[24px] border border-ash bg-paper p-7 glow-ring lg:col-span-2">
        <dl class="space-y-6">
          {
            rows.map((row) => (
              <div>
                <dt class="text-[0.7rem] font-semibold uppercase tracking-[0.12em] text-smoke">{row.label}</dt>
                <dd class="mt-1.5 text-[1.02rem] text-ink">
                  {row.kind === 'link' ? (
                    <a href={row.href} class="font-medium text-blue transition-opacity hover:opacity-70">
                      {row.value}
                    </a>
                  ) : (
                    <span class="whitespace-pre-line leading-relaxed text-graphite">{row.value}</span>
                  )}
                </dd>
              </div>
            ))
          }
        </dl>
        <a
          href={contact.mapsLink}
          target="_blank"
          rel="noopener noreferrer"
          class="pill mt-7 inline-flex items-center gap-2 bg-blue px-5 py-2.5 text-[0.9rem] font-semibold text-white transition-transform duration-200 hover:scale-[1.02]"
        >
          {t('contact.directions')}
          <span aria-hidden="true">&rarr;</span>
        </a>
      </div>

      {/* Harita */}
      <div class="overflow-hidden rounded-[24px] bg-paper p-2 glow-ring lg:col-span-3">
        <iframe
          title={lang === 'tr' ? 'Harita üzerinde konum' : 'Location on map'}
          src={contact.mapsEmbed}
          width="100%"
          height="100%"
          style="border:0; min-height: 380px; border-radius: 16px;"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          allowfullscreen
        ></iframe>
      </div>
    </div>
  </div>
</section>
