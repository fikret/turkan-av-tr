---
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';
import { contact } from '../data/site';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const rows = [
  { label: t('contact.address'), value: contact.addressLines.join('\n'), kind: 'text' as const },
  { label: t('contact.phone'), value: contact.phoneDisplay, href: `tel:${contact.phoneHref}`, kind: 'link' as const },
  { label: t('contact.email'), value: contact.email, href: `mailto:${contact.email}`, kind: 'link' as const },
];
---

<section id="iletisim" class="bg-paper-2">
  <div class="mx-auto max-w-[78rem] px-5 py-24 sm:px-8 lg:py-32">
    <div class="grid gap-12 lg:grid-cols-12 lg:gap-16">
      {/* Bilgiler */}
      <div class="lg:col-span-5">
        <h2 class="t-h2 text-forest">{t('contact.title')}</h2>
        <div class="rule-brass mt-7 w-20"></div>
        <p class="t-lead mt-7 text-ink-soft">{t('contact.subtitle')}</p>

        <dl class="mt-12 divide-y divide-line border-y border-line">
          {
            rows.map((row) => (
              <div class="grid grid-cols-3 gap-4 py-5">
                <dt class="t-eyebrow pt-1 text-ink-faint">{row.label}</dt>
                <dd class="col-span-2 text-[1.05rem] text-ink">
                  {row.kind === 'link' ? (
                    <a href={row.href} class="underline-offset-4 transition-colors hover:text-brass-deep hover:underline">
                      {row.value}
                    </a>
                  ) : (
                    <span class="whitespace-pre-line leading-relaxed">{row.value}</span>
                  )}
                </dd>
              </div>
            ))
          }
        </dl>

        <a
          href={contact.mapsLink}
          target="_blank"
          rel="noopener noreferrer"
          class="group mt-8 inline-flex items-center gap-2 text-sm font-semibold text-forest transition-colors duration-300 hover:text-brass-deep"
        >
          {t('contact.directions')}
          <span class="transition-transform duration-300 group-hover:translate-x-1" aria-hidden="true">&rarr;</span>
        </a>
      </div>

      {/* Harita */}
      <div class="lg:col-span-7">
        <div class="overflow-hidden border border-line">
          <iframe
            title={lang === 'tr' ? 'Harita üzerinde konum' : 'Location on map'}
            src={contact.mapsEmbed}
            width="100%"
            height="100%"
            style="border:0; min-height: 420px; filter: grayscale(0.2) contrast(1.05);"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            allowfullscreen
          ></iframe>
        </div>
      </div>
    </div>
  </div>
</section>
