---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';
import { contact } from '../data/site';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const siteImages = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/site/*.{jpg,jpeg,png,webp,avif}',
  { eager: true }
);
const interiorEntry = Object.entries(siteImages).find(([p]) => p.toLowerCase().includes('/interior.'));
const interiorImage = interiorEntry ? interiorEntry[1].default : null;
---

<section id="iletisim" class="border-t border-line bg-paper-2">
  <div class="mx-auto max-w-[78rem] px-6 py-20 sm:px-10 sm:py-28">
    <div class="grid gap-12 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-5">
        <h2 class="t-h2 text-ink">{t('contact.title')}</h2>
        <p class="t-lead mt-5 max-w-[34ch]">
          {lang === 'tr'
            ? 'Moda’daki büromuzda sizi ağırlamaktan memnuniyet duyarız.'
            : 'We would be glad to welcome you to our office in Moda.'}
        </p>
        <div class="rule mt-10"></div>

        <dl class="mt-8 space-y-7">
          <div>
            <dt class="t-label">{t('contact.address')}</dt>
            <dd class="mt-2 whitespace-pre-line text-[1.075rem] leading-relaxed text-ink">{contact.addressLines.join('\n')}</dd>
          </div>
          <div>
            <dt class="t-label">{t('contact.phone')}</dt>
            <dd class="mt-2 text-[1.075rem]"><a href={`tel:${contact.phoneHref}`} class="text-ink underline underline-offset-4 transition-colors hover:text-accent">{contact.phoneDisplay}</a></dd>
          </div>
          <div>
            <dt class="t-label">{t('contact.email')}</dt>
            <dd class="mt-2 text-[1.075rem]"><a href={`mailto:${contact.email}`} class="text-ink underline underline-offset-4 transition-colors hover:text-accent">{contact.email}</a></dd>
          </div>
        </dl>

        <a href={contact.mapsLink} target="_blank" rel="noopener noreferrer"
          class="mt-9 inline-flex items-center border border-ink px-6 py-3 text-[1.02rem] text-ink transition-colors duration-200 hover:bg-ink hover:text-paper">
          {t('contact.directions')}
        </a>
      </div>

      {/* Harita yerine rafine iç-mekan görseli (müşteri talebi: harita kalksın) */}
      <div class="lg:col-span-7">
        {interiorImage && (
          <Image src={interiorImage}
            alt={lang === 'tr' ? 'Rafine bir hukuk kütüphanesi' : 'A refined law library'}
            widths={[600, 900, 1280]} sizes="(max-width: 1024px) 100vw, 640px"
            class="grade-warm aspect-[5/4] w-full object-cover" />
        )}
      </div>
    </div>
  </div>
</section>
