---
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';
import { contact } from '../data/site';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section id="iletisim" class="bg-teal text-cream">
  <div class="mx-auto max-w-[1200px] px-5 py-20 sm:px-8 sm:py-24 lg:py-28">
    <div class="grid gap-12 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-5">
        <p class="t-mono-label text-butter">{t('contact.title')}</p>
        <h2 class="t-h2 mt-4 text-cream">{t('contact.subtitle')}</h2>
        <p class="mt-6 max-w-[34ch] text-[1.08rem] leading-[1.6] text-cream/85">
          {lang === 'tr'
            ? 'Moda’daki ofisimizde sizi ağırlamaktan memnuniyet duyarız.'
            : 'We would be glad to welcome you to our office in Moda.'}
        </p>
      </div>

      {/* beyaz inset bilgi kartı */}
      <div class="lg:col-span-7">
        <div class="frame bg-white p-7 text-ink sm:p-9">
          <dl class="grid gap-7 sm:grid-cols-3">
            <div class="sm:col-span-3">
              <dt class="t-mono-label text-ink/60">{t('contact.address')}</dt>
              <dd class="mt-2 whitespace-pre-line text-[1.05rem] leading-relaxed text-ink">
                {contact.addressLines.join('\n')}
              </dd>
            </div>
            <div>
              <dt class="t-mono-label text-ink/60">{t('contact.phone')}</dt>
              <dd class="mt-2 text-[1.02rem]">
                <a href={`tel:${contact.phoneHref}`} class="font-medium text-ink underline underline-offset-4 hover:bg-butter">{contact.phoneDisplay}</a>
              </dd>
            </div>
            <div class="sm:col-span-2">
              <dt class="t-mono-label text-ink/60">{t('contact.email')}</dt>
              <dd class="mt-2 text-[1.02rem]">
                <a href={`mailto:${contact.email}`} class="font-medium text-ink underline underline-offset-4 hover:bg-butter">{contact.email}</a>
              </dd>
            </div>
          </dl>
          <a
            href={contact.mapsLink}
            target="_blank"
            rel="noopener noreferrer"
            class="btn-sticker mt-8 inline-flex items-center gap-2 px-6 py-3 text-[0.9rem] font-bold uppercase tracking-wide"
          >
            {t('contact.directions')}
            <span aria-hidden="true">&rarr;</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
