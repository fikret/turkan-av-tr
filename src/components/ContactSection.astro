---
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';
import { contact } from '../data/site';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section id="iletisim" class="bg-graphite text-paper">
  <div class="mx-auto max-w-[1280px] px-5 py-[88px] sm:px-8 sm:py-[110px]">
    <div class="grid gap-12 lg:grid-cols-12 lg:gap-10">
      <div class="lg:col-span-5">
        <p class="t-caption text-paper/70">{t('contact.title')}</p>
        <h2 class="t-h mt-4 text-paper">{t('contact.subtitle')}</h2>

        <dl class="mt-10 space-y-6">
          <div>
            <dt class="t-caption text-paper/60">{t('contact.address')}</dt>
            <dd class="mt-1.5 t-body whitespace-pre-line leading-relaxed text-paper">{contact.addressLines.join('\n')}</dd>
          </div>
          <div>
            <dt class="t-caption text-paper/60">{t('contact.phone')}</dt>
            <dd class="mt-1.5 text-[1.05rem]"><a href={`tel:${contact.phoneHref}`} class="text-paper underline underline-offset-4 hover:opacity-70">{contact.phoneDisplay}</a></dd>
          </div>
          <div>
            <dt class="t-caption text-paper/60">{t('contact.email')}</dt>
            <dd class="mt-1.5 text-[1.05rem]"><a href={`mailto:${contact.email}`} class="text-paper underline underline-offset-4 hover:opacity-70">{contact.email}</a></dd>
          </div>
        </dl>

        <a href={contact.mapsLink} target="_blank" rel="noopener noreferrer"
          class="btn-pill btn-pill-light mt-9 inline-flex items-center gap-2 px-6 py-3 text-[0.95rem]">
          {t('contact.directions')}
          <span aria-hidden="true">&rarr;</span>
        </a>
      </div>

      <div class="lg:col-span-7">
        <div class="overflow-hidden rounded-[8px] border border-paper/20">
          <iframe
            title={lang === 'tr' ? 'Harita üzerinde konum' : 'Location on map'}
            src={contact.mapsEmbed}
            width="100%" height="100%"
            style="border:0; min-height: 400px; filter: grayscale(1) contrast(1.05);"
            loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen
          ></iframe>
        </div>
      </div>
    </div>
  </div>
</section>
