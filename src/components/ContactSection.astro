---
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';
import { contact } from '../data/site';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section id="iletisim" class="bg-white">
  <div class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8 lg:py-28">
    <div class="max-w-2xl">
      <p class="text-sm font-semibold uppercase tracking-[0.18em] text-gold-600">
        {t('contact.title')}
      </p>
      <h2 class="mt-3 font-serif text-3xl font-semibold leading-tight text-ink sm:text-4xl">
        {t('contact.subtitle')}
      </h2>
    </div>

    <div class="mt-12 grid gap-10 lg:grid-cols-2 lg:gap-16">
      {/* Bilgiler */}
      <div class="space-y-8">
        <div>
          <h3 class="text-xs font-semibold uppercase tracking-wide text-ink-500">{t('contact.address')}</h3>
          <address class="mt-2 space-y-0.5 text-base not-italic leading-relaxed text-ink-700">
            {contact.addressLines.map((line) => <p>{line}</p>)}
          </address>
          <a
            href={contact.mapsLink}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-3 inline-flex items-center gap-2 text-sm font-semibold text-gold-600 transition-colors hover:text-ink"
          >
            {t('contact.directions')}
            <span aria-hidden="true">&rarr;</span>
          </a>
        </div>

        <div>
          <h3 class="text-xs font-semibold uppercase tracking-wide text-ink-500">{t('contact.phone')}</h3>
          <p class="mt-2 text-base text-ink-700">
            <a href={`tel:${contact.phoneHref}`} class="transition-colors hover:text-gold-600">{contact.phoneDisplay}</a>
          </p>
        </div>

        <div>
          <h3 class="text-xs font-semibold uppercase tracking-wide text-ink-500">{t('contact.email')}</h3>
          <p class="mt-2 text-base text-ink-700">
            <a href={`mailto:${contact.email}`} class="transition-colors hover:text-gold-600">{contact.email}</a>
          </p>
        </div>
      </div>

      {/* Harita */}
      <div class="overflow-hidden rounded-md border border-ink/10">
        <iframe
          title={lang === 'tr' ? 'Harita üzerinde konum' : 'Location on map'}
          src={contact.mapsEmbed}
          width="100%"
          height="100%"
          style="border:0; min-height: 360px;"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          allowfullscreen
        ></iframe>
      </div>
    </div>
  </div>
</section>
