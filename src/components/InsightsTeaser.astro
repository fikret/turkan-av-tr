---
import type { Lang } from '../i18n/ui';
import { useTranslations, routeMap, withBase } from '../i18n/utils';
import { getInsights, formatDate } from '../lib/insights';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const posts = (await getInsights(lang)).slice(0, 3);
const base = withBase(lang === 'tr' ? '/guncel' : '/en/insights');
---

<section id="guncel" class="border-t border-line bg-paper">
  <div class="mx-auto max-w-[78rem] px-6 py-20 sm:px-10 sm:py-28">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <h2 class="t-h2 text-ink">{t('insights.title')}</h2>
      {posts.length > 0 && (
        <a href={routeMap.insights[lang]} class="inline-flex items-center gap-2 text-[1.02rem] text-accent underline underline-offset-[6px] transition-opacity hover:opacity-70">
          {t('insights.all')}<span aria-hidden="true">&rarr;</span>
        </a>
      )}
    </div>
    <div class="rule mt-8"></div>

    {
      posts.length === 0 ? (
        <p class="mt-10 text-ink-faint">{t('insights.empty')}</p>
      ) : (
        <ul class="mt-10 grid gap-y-10 md:grid-cols-3 md:gap-x-12">
          {posts.map((post) => (
            <li>
              <a href={`${base}/${post.data.slug}`} class="group block">
                <p class="t-label">{formatDate(post.data.pubDate, lang)}</p>
                <h3 class="t-h3 mt-3 text-ink transition-colors duration-200 group-hover:text-accent">{post.data.title}</h3>
                <p class="prose-justify mt-3 text-[1rem] leading-[1.6] text-ink-soft">{post.data.description}</p>
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</section>
