---
import type { Lang } from '../i18n/ui';
import { useTranslations, routeMap, withBase } from '../i18n/utils';
import { getInsights, formatDate } from '../lib/insights';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const posts = (await getInsights(lang)).slice(0, 3);
const base = withBase(lang === 'tr' ? '/guncel' : '/en/insights');
---

<section id="guncel" class="bg-paper">
  <div class="mx-auto max-w-[1280px] px-5 py-[88px] sm:px-8 sm:py-[110px]">
    <div class="grid gap-8 lg:grid-cols-12 lg:gap-6">
      <div class="lg:col-span-3"><p class="t-caption text-obsidian">{t('insights.title')}</p></div>
      <div class="lg:col-span-9 lg:pl-10"><h2 class="t-h max-w-[20ch] text-obsidian">{t('insights.subtitle')}</h2></div>
    </div>

    {
      posts.length === 0 ? (
        <p class="mt-10 t-body text-muted">{t('insights.empty')}</p>
      ) : (
        <div class="mt-12 grid gap-5 md:grid-cols-3">
          {posts.map((post) => (
            <a href={`${base}/${post.data.slug}`} class="group flex flex-col rounded-[8px] border border-linen bg-paper p-6 transition-colors hover:border-obsidian">
              <p class="t-caption text-muted">{formatDate(post.data.pubDate, lang)}</p>
              <h3 class="t-hsm mt-3 text-obsidian">{post.data.title}</h3>
              <p class="mt-2.5 text-[0.98rem] leading-[1.5] text-obsidian/85">{post.data.description}</p>
              <span class="t-caption mt-5 inline-flex items-center gap-1.5 text-obsidian underline underline-offset-4">
                {t('insights.all')}
                <span class="transition-transform group-hover:translate-x-1" aria-hidden="true">&rarr;</span>
              </span>
            </a>
          ))}
        </div>
      )
    }
  </div>
</section>
