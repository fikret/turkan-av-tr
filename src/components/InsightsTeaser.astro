---
import type { Lang } from '../i18n/ui';
import { useTranslations, routeMap, withBase } from '../i18n/utils';
import { getInsights, formatDate } from '../lib/insights';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const posts = (await getInsights(lang)).slice(0, 3);
const base = withBase(lang === 'tr' ? '/guncel' : '/en/insights');
---

<section id="guncel" class="bg-cream">
  <div class="mx-auto max-w-[1200px] px-5 py-20 sm:px-8 sm:py-24 lg:py-28">
    <div class="max-w-[44rem]">
      <p class="t-mono-label text-ink/70">{t('insights.title')}</p>
      <h2 class="t-h2 mt-4 text-ink">{t('insights.subtitle')}</h2>
    </div>

    {
      posts.length === 0 ? (
        <p class="mt-10 text-ink/70">{t('insights.empty')}</p>
      ) : (
        <div class="mt-12 grid gap-6 md:grid-cols-3">
          {posts.map((post) => (
            <a href={`${base}/${post.data.slug}`} class="frame group flex flex-col bg-white p-7 transition-colors duration-150 hover:bg-cream">
              <p class="t-mono-label text-ink/70">{formatDate(post.data.pubDate, lang)}</p>
              <h3 class="mt-3 text-[1.3rem] font-bold leading-tight text-ink">{post.data.title}</h3>
              <p class="mt-2.5 text-[0.98rem] leading-[1.55] text-ink/85">{post.data.description}</p>
              <span class="mt-5 inline-flex items-center gap-1.5 text-[0.88rem] font-bold text-ink underline underline-offset-4">
                {t('insights.all')}
                <span class="transition-transform duration-150 group-hover:translate-x-1" aria-hidden="true">&rarr;</span>
              </span>
            </a>
          ))}
        </div>
      )
    }

    {
      posts.length > 0 && (
        <div class="mt-10">
          <a href={routeMap.insights[lang]} class="btn-ghost inline-flex items-center gap-2 px-5 py-2.5 text-[0.9rem] font-medium">
            {t('insights.all')}
            <span aria-hidden="true">&rarr;</span>
          </a>
        </div>
      )
    }
  </div>
</section>
