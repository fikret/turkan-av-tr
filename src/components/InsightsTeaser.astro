---
import type { Lang } from '../i18n/ui';
import { useTranslations, routeMap, withBase } from '../i18n/utils';
import { getInsights, formatDate } from '../lib/insights';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const posts = (await getInsights(lang)).slice(0, 3);
const base = withBase(lang === 'tr' ? '/guncel' : '/en/insights');
---

<section id="guncel" class="bg-paper py-[88px] sm:py-[110px]">
  <div class="mx-auto max-w-[1100px] px-5 sm:px-8">
    <div class="text-center">
      <h2 class="t-h2 text-ink">{t('insights.title')}</h2>
      <p class="mx-auto mt-4 max-w-[44ch] text-[1.1rem] leading-relaxed text-smoke">{t('insights.subtitle')}</p>
    </div>

    {
      posts.length === 0 ? (
        <p class="mt-10 text-center text-smoke">{t('insights.empty')}</p>
      ) : (
        <div class="mt-12 grid gap-6 md:grid-cols-3">
          {posts.map((post) => (
            <a
              href={`${base}/${post.data.slug}`}
              class="group flex flex-col rounded-[24px] border border-ash bg-paper p-6 glow-ring transition-transform duration-300 hover:-translate-y-1"
            >
              <p class="text-[0.78rem] font-semibold uppercase tracking-[0.1em] text-blue">
                {formatDate(post.data.pubDate, lang)}
              </p>
              <h3 class="mt-3 font-display text-[1.4rem] leading-tight text-ink">
                {post.data.title}
              </h3>
              <p class="mt-2.5 text-[0.95rem] leading-[1.55] text-graphite">{post.data.description}</p>
              <span class="mt-4 inline-flex items-center gap-1.5 text-[0.88rem] font-semibold text-blue">
                {t('insights.all')}
                <span class="transition-transform duration-200 group-hover:translate-x-1" aria-hidden="true">&rarr;</span>
              </span>
            </a>
          ))}
        </div>
      )
    }

    {
      posts.length > 0 && (
        <div class="mt-10 text-center">
          <a
            href={routeMap.insights[lang]}
            class="inline-flex items-center gap-1.5 text-[0.95rem] font-semibold text-blue transition-opacity duration-200 hover:opacity-70"
          >
            {t('insights.all')}
            <span aria-hidden="true">&rarr;</span>
          </a>
        </div>
      )
    }
  </div>
</section>
