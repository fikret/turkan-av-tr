---
import type { Lang } from '../i18n/ui';
import { useTranslations, localizedPath, routeMap } from '../i18n/utils';
import { getInsights, formatDate } from '../lib/insights';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const posts = (await getInsights(lang)).slice(0, 3);
const base = lang === 'tr' ? '/guncel' : '/en/insights';
---

<section id="guncel" class="bg-cream">
  <div class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8 lg:py-28">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div class="max-w-2xl">
        <p class="text-sm font-semibold uppercase tracking-[0.18em] text-gold-600">
          {t('insights.title')}
        </p>
        <h2 class="mt-3 font-serif text-3xl font-semibold leading-tight text-ink sm:text-4xl">
          {t('insights.subtitle')}
        </h2>
      </div>
      {
        posts.length > 0 && (
          <a
            href={routeMap.insights[lang]}
            class="inline-flex items-center gap-2 text-sm font-semibold text-gold-600 transition-colors hover:text-ink"
          >
            {t('insights.all')}
            <span aria-hidden="true">&rarr;</span>
          </a>
        )
      }
    </div>

    {
      posts.length === 0 ? (
        <p class="mt-10 text-base text-ink-500">{t('insights.empty')}</p>
      ) : (
        <div class="mt-12 grid gap-8 md:grid-cols-3">
          {posts.map((post) => (
            <article class="group">
              <a href={`${base}/${post.data.slug}`} class="block">
                <p class="text-xs font-medium uppercase tracking-wide text-gold-600">
                  {formatDate(post.data.pubDate, lang)}
                </p>
                <h3 class="mt-2 font-serif text-xl font-semibold leading-snug text-ink transition-colors group-hover:text-gold-600">
                  {post.data.title}
                </h3>
                <p class="mt-2 text-sm leading-relaxed text-ink-500">{post.data.description}</p>
              </a>
            </article>
          ))}
        </div>
      )
    }
  </div>
</section>
