---
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';
import { aboutParagraphs } from '../data/about';
import { contact } from '../data/site';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section id="hakkimizda" class="bg-teal text-cream">
  <div class="mx-auto max-w-[1200px] px-5 py-20 sm:px-8 sm:py-24 lg:py-28">
    <div class="grid gap-12 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-7">
        <p class="t-mono-label text-butter">{t('about.title')}</p>
        <h2 class="t-h2 mt-4 text-cream">
          {lang === 'tr'
            ? 'Güvene dayalı, çözüm odaklı hukuk anlayışı.'
            : 'Trust-based, solution-oriented legal practice.'}
        </h2>
        <div class="mt-8 space-y-5">
          {
            aboutParagraphs.map((p, i) => (
              <p class={`leading-[1.6] text-cream/90 ${i === 0 ? 'text-[1.12rem]' : 'text-[1rem]'}`}>
                {p[lang]}
              </p>
            ))
          }
        </div>
      </div>

      {/* sağ: stat + line-art */}
      <div class="lg:col-span-5">
        <div class="flex items-baseline gap-3">
          <span class="text-[4.5rem] font-bold leading-none text-butter">{contact.foundedYear}</span>
          <span class="t-mono-label text-cream/80">{lang === 'tr' ? 'yılından bu yana' : 'serving since'}</span>
        </div>
        <div class="mt-8 border border-cream/30 bg-teal p-6">
          <svg viewBox="0 0 360 220" class="h-auto w-full" role="img"
            aria-label={lang === 'tr' ? 'İş akışı şeması' : 'Workflow diagram'}>
            <g fill="none" stroke="#fffcf7" stroke-width="1.5">
              <rect x="20" y="30" width="96" height="60" />
              <rect x="135" y="80" width="96" height="60" />
              <rect x="250" y="30" width="96" height="60" />
              <path d="M116 60 H135 M231 110 H250 M250 60 H298 M298 60 V90" />
              <line x1="36" y1="52" x2="100" y2="52" />
              <line x1="36" y1="68" x2="84" y2="68" />
              <line x1="151" y1="102" x2="215" y2="102" />
              <line x1="266" y1="52" x2="330" y2="52" />
            </g>
            <g fill="#fae59b" stroke="#0d0129" stroke-width="1">
              <circle cx="183" cy="160" r="7" />
              <circle cx="298" cy="120" r="7" />
            </g>
            <rect x="135" y="80" width="14" height="60" fill="#fae59b" stroke="none" />
          </svg>
        </div>
      </div>
    </div>
  </div>
</section>
