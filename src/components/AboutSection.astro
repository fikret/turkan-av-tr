---
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';
import { aboutParagraphs } from '../data/about';
import { contact } from '../data/site';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section id="hakkimizda" class="border-t border-line bg-paper">
  <div class="mx-auto max-w-[78rem] px-6 py-20 sm:px-10 sm:py-28">
    <h2 class="t-h2 max-w-[22ch] text-ink">{t('about.title')}</h2>
    <p class="t-lead mt-5 max-w-[40rem]">
      {lang === 'tr'
        ? 'Önleyici, çözüm odaklı ve etkin hukuki destek — 2014’ten bu yana.'
        : 'Preventive, solution-oriented and effective legal support — since 2014.'}
    </p>
    <div class="rule mt-10"></div>

    <div class="prose-justify mt-10 columns-1 gap-14 text-[1.075rem] leading-[1.66] text-ink-soft md:columns-2 [&>p]:mb-5 [&>p]:break-inside-avoid">
      {aboutParagraphs.map((p) => <p>{p[lang]}</p>)}
    </div>
  </div>
</section>
