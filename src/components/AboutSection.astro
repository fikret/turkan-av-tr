---
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';
import { aboutParagraphs } from '../data/about';
import { contact } from '../data/site';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section id="hakkimizda" class="bg-ash py-[88px] sm:py-[110px]">
  <div class="mx-auto max-w-[44rem] px-5 sm:px-8">
    <div class="text-center">
      <h2 class="t-h2 text-ink">{t('about.title')}</h2>
      <p class="mx-auto mt-4 max-w-[40ch] text-[1.1rem] leading-relaxed text-smoke">
        {lang === 'tr'
          ? 'Güvene dayalı, çözüm odaklı hukuk anlayışı — 2014’ten bu yana.'
          : 'Trust-based, solution-oriented legal practice — since 2014.'}
      </p>
    </div>

    <div class="mx-auto mt-10 max-w-[42rem] space-y-5">
      {
        aboutParagraphs.map((p, i) => (
          <p class={`leading-[1.6] text-graphite ${i === 0 ? 'text-[1.08rem]' : 'text-[1rem]'}`}>
            {p[lang]}
          </p>
        ))
      }
    </div>
  </div>
</section>
