---
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';
import { aboutParagraphs } from '../data/about';
import { contact } from '../data/site';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section id="hakkimizda" class="border-t border-line bg-night">
  <div class="mx-auto max-w-[80rem] px-5 py-24 sm:px-8 lg:py-32">
    <div class="grid gap-14 lg:grid-cols-12 lg:gap-20">
      <div class="lg:col-span-5">
        <h2 class="t-h2 text-ivory">{t('about.title')}</h2>
        <div class="rule-garnet mt-7 w-20"></div>
        <p class="t-lead mt-7">
          {lang === 'tr'
            ? 'Güvene dayalı, çözüm odaklı hukuk anlayışı.'
            : 'Trust-based, solution-oriented legal practice.'}
        </p>
        <p class="mt-10 flex items-baseline gap-3">
          <span class="font-display text-7xl font-medium leading-none text-garnet-bright">{contact.foundedYear}</span>
          <span class="text-sm text-ivory-faint">
            {lang === 'tr' ? 'yılından bu yana' : 'serving since'}
          </span>
        </p>
      </div>

      <div class="space-y-6 lg:col-span-7">
        {
          aboutParagraphs.map((p, i) => (
            <p
              class={`prose-measure leading-[1.75] ${i === 0 ? 'text-[1.18rem] text-ivory' : 'text-[1.02rem] text-ivory-soft'}`}
            >
              {p[lang]}
            </p>
          ))
        }
      </div>
    </div>
  </div>
</section>
