---
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';
import { aboutParagraphs } from '../data/about';
import { contact } from '../data/site';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section id="hakkimizda" class="bg-paper">
  <div class="mx-auto max-w-[78rem] px-5 py-24 sm:px-8 lg:py-32">
    <div class="grid gap-14 lg:grid-cols-12 lg:gap-20">
      {/* Sol: başlık + köklülük işareti */}
      <div class="lg:col-span-5">
        <h2 class="t-h2 text-forest">{t('about.title')}</h2>
        <div class="rule-brass mt-7 w-20"></div>
        <p class="t-lead mt-7 text-ink-soft">
          {lang === 'tr'
            ? 'Güvene dayalı, çözüm odaklı hukuk anlayışı.'
            : 'Trust-based, solution-oriented legal practice.'}
        </p>
        <p class="mt-9 flex items-baseline gap-3">
          <span class="font-serif text-6xl leading-none text-forest">{contact.foundedYear}</span>
          <span class="text-sm text-ink-faint">
            {lang === 'tr' ? 'yılından bu yana' : 'serving since'}
          </span>
        </p>
      </div>

      {/* Sağ: metin */}
      <div class="space-y-6 lg:col-span-7">
        {
          aboutParagraphs.map((p, i) => (
            <p
              class={`leading-[1.75] text-ink-soft prose-measure ${i === 0 ? 'text-[1.18rem] text-ink' : 'text-[1.02rem]'}`}
            >
              {p[lang]}
            </p>
          ))
        }
      </div>
    </div>
  </div>
</section>
