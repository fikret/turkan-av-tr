---
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';
import { aboutParagraphs } from '../data/about';
import { contact } from '../data/site';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section id="hakkimizda" class="bg-paper">
  <div class="mx-auto max-w-[1280px] px-5 py-[88px] sm:px-8 sm:py-[110px]">
    <div class="grid gap-10 lg:grid-cols-12 lg:gap-6">
      {/* sol: caption */}
      <div class="lg:col-span-3">
        <p class="t-caption text-obsidian">{t('about.title')}</p>
        <div class="rule mt-5 w-full"></div>
        <p class="mt-5 flex items-baseline gap-2">
          <span class="text-[2.75rem] font-medium leading-none text-obsidian">{contact.foundedYear}</span>
          <span class="t-caption text-muted">{lang === 'tr' ? '—' : '—'}</span>
        </p>
        <p class="t-caption mt-1 text-muted">{lang === 'tr' ? 'yılından bu yana' : 'serving since'}</p>
      </div>

      {/* sağ: başlık + gövde */}
      <div class="lg:col-span-9 lg:pl-10">
        <h2 class="t-h max-w-[22ch] text-obsidian">
          {lang === 'tr'
            ? 'Güvene dayalı, çözüm odaklı hukuk anlayışı.'
            : 'Trust-based, solution-oriented legal practice.'}
        </h2>
        <div class="mt-8 grid gap-x-12 gap-y-5 md:grid-cols-2">
          {
            aboutParagraphs.map((p) => (
              <p class="t-body leading-[1.5] text-obsidian/90">{p[lang]}</p>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>
