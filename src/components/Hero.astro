---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import type { Lang } from '../i18n/ui';
import { useTranslations, routeMap } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const siteImages = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/site/*.{jpg,jpeg,png,webp,avif}',
  { eager: true }
);
const heroEntry = Object.entries(siteImages).find(([p]) =>
  p.toLowerCase().includes('/hero.')
);
const heroImage = heroEntry ? heroEntry[1].default : null;
---

<section class="relative isolate overflow-hidden bg-night text-ivory">
  {/* Koyu duotone mimari arka plan */}
  <div class="absolute inset-0 -z-10" aria-hidden="true">
    {heroImage && (
      <Image
        src={heroImage}
        alt=""
        widths={[768, 1280, 1920]}
        sizes="100vw"
        loading="eager"
        class="h-full w-full object-cover opacity-[0.32]"
      />
    )}
    <div class="absolute inset-0 bg-night mix-blend-multiply"></div>
    <div
      class="absolute inset-0"
      style="background: linear-gradient(180deg, oklch(0.18 0.013 48 / 0.55) 0%, oklch(0.18 0.013 48 / 0.78) 60%, oklch(0.18 0.013 48) 100%);"
    ></div>
    {/* sıcak garnet ışıma */}
    <div
      class="absolute inset-0 opacity-60"
      style="background: radial-gradient(70% 55% at 78% 12%, oklch(0.56 0.135 24 / 0.20), transparent 62%);"
    ></div>
  </div>

  <div class="mx-auto grid min-h-[90vh] max-w-[80rem] items-center px-5 py-28 sm:px-8">
    <div class="max-w-[54rem]">
      <p class="t-kicker anim-rise uppercase tracking-[0.22em] text-garnet-bright">
        Est. 2014 · Moda, Kadıköy
      </p>

      <h1 class="t-display anim-rise-2 mt-7 text-ivory">
        {t('hero.title')}
      </h1>

      <div class="rule-garnet anim-rule mt-9 w-32"></div>

      <p class="t-lead anim-rise-3 prose-measure mt-9">
        {t('hero.subtitle')}
      </p>

      <div class="anim-rise-4 mt-12 flex flex-col gap-3 sm:flex-row sm:items-center">
        <a
          href={routeMap.practice[lang]}
          class="group inline-flex items-center justify-center gap-2 bg-garnet-bright px-8 py-4 text-sm font-semibold text-night transition-all duration-300 hover:bg-ivory"
        >
          {t('hero.cta.practice')}
          <span class="transition-transform duration-300 group-hover:translate-x-1" aria-hidden="true">&rarr;</span>
        </a>
        <a
          href={routeMap.contact[lang]}
          class="inline-flex items-center justify-center border border-line-strong px-8 py-4 text-sm font-semibold text-ivory transition-colors duration-300 hover:border-garnet-bright hover:text-garnet-bright"
        >
          {t('hero.cta.contact')}
        </a>
      </div>

      <div class="anim-rise-4 mt-16 flex items-center gap-3 text-ivory-faint">
        <span class="h-px w-8 bg-line-strong" aria-hidden="true"></span>
        <span class="text-[0.78rem] font-medium uppercase tracking-[0.16em]">
          {t('hero.member')}
        </span>
      </div>
    </div>
  </div>
</section>
