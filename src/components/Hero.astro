---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import type { Lang } from '../i18n/ui';
import { useTranslations, routeMap } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const siteImages = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/site/*.{jpg,jpeg,png,webp,avif}',
  { eager: true }
);
const heroEntry = Object.entries(siteImages).find(([p]) => p.toLowerCase().includes('/hero.'));
const heroImage = heroEntry ? heroEntry[1].default : null;
---

<section class="bg-paper">
  <div class="mx-auto max-w-[78rem] px-6 pb-14 pt-16 sm:px-10 sm:pb-20 sm:pt-24">
    <p class="anim-rise t-label">{lang === 'tr' ? 'Est. 2014 — Moda, Kadıköy' : 'Est. 2014 — Moda, Kadıköy'}</p>

    {/* SLOGAN — müşteri kendi sloganını verecek; şimdilik değer önermesi */}
    <h1 class="t-display anim-rise mt-6 max-w-[20ch] text-ink">{t('hero.title')}</h1>

    <p class="t-lead prose-justify anim-rise-2 mt-8 max-w-[42rem]">{t('hero.subtitle')}</p>

    <div class="anim-rise-2 mt-10 flex flex-col items-start gap-5 sm:flex-row sm:items-center">
      <a href={routeMap.practice[lang]}
        class="inline-flex items-center border border-ink px-7 py-3 text-[1.02rem] text-ink transition-colors duration-200 hover:bg-ink hover:text-paper">
        {t('hero.cta.practice')}
      </a>
      <a href={routeMap.contact[lang]}
        class="inline-flex items-center gap-2 text-[1.02rem] text-accent underline underline-offset-[6px] transition-opacity hover:opacity-70">
        {t('hero.cta.contact')}
        <span aria-hidden="true">&rarr;</span>
      </a>
    </div>
  </div>

  {/* Premium görsel bandı — tutarlı sıcak grade */}
  {heroImage && (
    <div class="anim-rise-3 mx-auto max-w-[90rem] px-0 sm:px-6">
      <Image
        src={heroImage}
        alt={lang === 'tr' ? 'Moda, Kadıköy — büromuzun bulunduğu semtten bir görünüm' : 'Moda, Kadıköy — a view from our neighbourhood'}
        widths={[768, 1280, 1920, 2400]}
        sizes="100vw"
        loading="eager"
        class="grade-warm h-[44vh] min-h-[320px] w-full object-cover sm:h-[60vh]"
      />
    </div>
  )}
</section>
