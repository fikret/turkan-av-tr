---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import type { Lang } from '../i18n/ui';
import { useTranslations, routeMap } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const siteImages = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/site/*.{jpg,jpeg,png,webp,avif}',
  { eager: true }
);
const heroEntry = Object.entries(siteImages).find(([p]) =>
  p.toLowerCase().includes('/hero.')
);
const heroImage = heroEntry ? heroEntry[1].default : null;

const eyebrow =
  lang === 'tr' ? 'Est. 2014 · Moda, Kadıköy' : 'Est. 2014 · Moda, Kadıköy';
---

<section class="relative isolate overflow-hidden bg-forest-deep text-cream">
  {/* Arka plan: mimari görsel, yeşil duotone'a boyanmış */}
  <div class="absolute inset-0 -z-10" aria-hidden="true">
    {heroImage && (
      <Image
        src={heroImage}
        alt=""
        widths={[768, 1280, 1920]}
        sizes="100vw"
        loading="eager"
        class="h-full w-full object-cover"
      />
    )}
    <div class="absolute inset-0 bg-forest-deep mix-blend-multiply"></div>
    <div
      class="absolute inset-0"
      style="background: linear-gradient(105deg, oklch(0.19 0.03 162 / 0.96) 0%, oklch(0.22 0.036 160 / 0.82) 48%, oklch(0.24 0.038 160 / 0.55) 100%);"
    ></div>
  </div>

  <div class="mx-auto grid min-h-[88vh] max-w-[78rem] items-center px-5 py-28 sm:px-8 lg:min-h-[90vh]">
    <div class="max-w-3xl">
      <p class="t-eyebrow anim-rise text-brass">{eyebrow}</p>

      <h1 class="t-display anim-rise-2 mt-6 text-cream">
        {t('hero.title')}
      </h1>

      <div class="rule-brass anim-rule mt-8 w-28"></div>

      <p class="t-lead anim-rise-3 prose-measure mt-8 text-cream-soft">
        {t('hero.subtitle')}
      </p>

      <div class="anim-rise-4 mt-11 flex flex-col gap-x-8 gap-y-5 sm:flex-row sm:items-center">
        <div class="flex flex-col gap-3 sm:flex-row sm:items-center">
          <a
            href={routeMap.practice[lang]}
            class="group inline-flex items-center justify-center gap-2 bg-brass px-7 py-3.5 text-sm font-semibold text-forest-900 transition-colors duration-300 hover:bg-cream"
          >
            {t('hero.cta.practice')}
            <span class="transition-transform duration-300 group-hover:translate-x-1" aria-hidden="true">&rarr;</span>
          </a>
          <a
            href={routeMap.contact[lang]}
            class="inline-flex items-center justify-center border border-cream/30 px-7 py-3.5 text-sm font-semibold text-cream transition-colors duration-300 hover:border-brass hover:text-brass"
          >
            {t('hero.cta.contact')}
          </a>
        </div>
      </div>

      {/* "we connect" üyelik rozeti */}
      <div class="anim-rise-4 mt-14 flex items-center gap-3 text-cream-soft">
        <span class="h-px w-8 bg-cream/30" aria-hidden="true"></span>
        <span class="text-[0.78rem] font-medium uppercase tracking-[0.16em]">
          {t('hero.member')}
        </span>
      </div>
    </div>
  </div>
</section>
