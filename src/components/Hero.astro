---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import type { Lang } from '../i18n/ui';
import { useTranslations, routeMap } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const siteImages = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/site/*.{jpg,jpeg,png,webp,avif}',
  { eager: true }
);
const heroEntry = Object.entries(siteImages).find(([p]) =>
  p.toLowerCase().includes('/hero.')
);
const heroImage = heroEntry ? heroEntry[1].default : null;
---

<section
  class="relative overflow-hidden"
  style="background: linear-gradient(180deg, #4a7ff2 0%, #7b7ed8 30%, #c98ab5 65%, #e8a87c 100%);"
>
  {/* metin okunabilirliği için üstte ince koyu örtü (beyaz metni AA'ya taşır) */}
  <div
    class="pointer-events-none absolute inset-x-0 top-0 z-0 h-[58%]"
    aria-hidden="true"
    style="background: linear-gradient(180deg, rgba(18,20,45,0.42) 0%, rgba(18,20,45,0.22) 42%, transparent 100%);"
  ></div>

  {/* alt silüet (ağaç/ufuk hattı) */}
  <div class="pointer-events-none absolute inset-x-0 bottom-0 z-0" aria-hidden="true">
    <svg viewBox="0 0 1440 160" preserveAspectRatio="none" class="h-[120px] w-full sm:h-[150px]">
      <path
        fill="#2b2d54"
        d="M0,160 L0,96 Q120,78 220,92 L250,70 270,92 Q360,86 440,98 L470,64 492,98 Q620,90 720,104 L752,72 774,104 Q900,96 1010,108 L1040,76 1062,108 Q1200,100 1320,90 L1352,66 1374,92 Q1410,96 1440,92 L1440,160 Z"
      />
    </svg>
  </div>

  <div class="relative z-10 mx-auto max-w-[1100px] px-5 pb-0 pt-[8.5rem] text-center sm:px-8 sm:pt-[10rem]">
    <p class="anim-rise text-[0.82rem] font-medium uppercase tracking-[0.16em] text-white/85">
      Est. 2014 · Moda, Kadıköy
    </p>
    <h1 class="t-display anim-rise-2 mx-auto mt-6 max-w-[18ch] text-white">
      {t('hero.title')}
    </h1>
    <p class="anim-rise-3 mx-auto mt-6 max-w-[44ch] text-[1.1rem] leading-relaxed text-white/90">
      {t('hero.subtitle')}
    </p>

    <div class="anim-rise-4 mt-9 flex flex-col items-center justify-center gap-3 sm:flex-row">
      <a
        href={routeMap.practice[lang]}
        class="pill btn-elev inline-flex items-center gap-2 bg-paper px-6 py-3.5 text-[0.95rem] font-semibold text-ink transition-transform duration-200 hover:scale-[1.02]"
      >
        {t('hero.cta.practice')}
        <span aria-hidden="true">&rarr;</span>
      </a>
      <a
        href={routeMap.contact[lang]}
        class="pill inline-flex items-center border-[1.5px] border-white/80 px-6 py-3.5 text-[0.95rem] font-medium text-white transition-colors duration-200 hover:bg-white/10"
      >
        {t('hero.cta.contact')}
      </a>
    </div>

    {/* glow-ring çerçeveli mimari görsel — silüetin üstüne biner */}
    {heroImage && (
      <div class="anim-rise-4 mx-auto mt-14 max-w-[860px] rounded-[30px] bg-paper p-2 glow-ring sm:mt-16">
        <Image
          src={heroImage}
          alt=""
          widths={[760, 1100, 1600]}
          sizes="(max-width: 900px) 92vw, 860px"
          loading="eager"
          class="aspect-[16/9] w-full rounded-[22px] object-cover"
        />
      </div>
    )}

    {/* boşluk: görselin silüete binmesi için */}
    <div class="h-16 sm:h-20"></div>
  </div>
</section>
