---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import type { Lang } from '../i18n/ui';
import { useTranslations, routeMap } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const siteImages = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/site/*.{jpg,jpeg,png,webp,avif}',
  { eager: true }
);
const heroEntry = Object.entries(siteImages).find(([p]) =>
  p.toLowerCase().includes('/hero.')
);
const heroImage = heroEntry ? heroEntry[1].default : null;
---

<section class="relative flex min-h-[100svh] flex-col justify-between bg-gunmetal">
  <div class="mx-auto w-full max-w-[1280px] px-5 pb-10 pt-32 sm:px-8 sm:pt-36">
    <div class="grid items-end gap-10 lg:grid-cols-2 lg:gap-16">
      {/* Sol: ikincil başlık + CTA */}
      <div>
        <p class="t-caption anim-rise max-w-[280px] text-obsidian">Est. 2014 — Moda, Kadıköy</p>
        <h1 class="t-h anim-rise mt-6 max-w-[16ch] text-obsidian">{t('hero.title')}</h1>
        <div class="anim-rise-2 mt-8 flex flex-col items-start gap-4 sm:flex-row sm:items-center">
          <a href={routeMap.practice[lang]} class="btn-pill btn-pill-dark px-7 py-3.5 text-[1rem]">
            {t('hero.cta.practice')}
          </a>
          <a href={routeMap.contact[lang]} class="t-caption inline-flex items-center gap-2 text-obsidian underline underline-offset-[6px]">
            {t('hero.cta.contact')}
            <span aria-hidden="true">&rarr;</span>
          </a>
        </div>
        <p class="t-caption anim-rise-2 mt-10 flex items-center gap-2.5 text-obsidian">
          <span class="h-2.5 w-2.5 border border-obsidian" aria-hidden="true"></span>
          {t('hero.member')}
        </p>
      </div>

      {/* Sağ: gri-tonlama mimari görsel */}
      {heroImage && (
        <div class="anim-rise-2 overflow-hidden rounded-[8px] border border-linen">
          <Image
            src={heroImage}
            alt=""
            widths={[600, 900, 1280]}
            sizes="(max-width: 1024px) 92vw, 600px"
            loading="eager"
            class="grayscale-img aspect-[4/3] w-full object-cover"
          />
        </div>
      )}
    </div>
  </div>

  {/* Monolitik wordmark — galeriyi taban hizalar */}
  <div class="mx-auto w-full max-w-[1280px] px-5 pb-8 sm:px-8 sm:pb-12">
    <h2
      class="anim-rise-3 font-medium leading-[0.92] text-obsidian"
      style="font-size: clamp(2.5rem, 8.2vw, 5.75rem); letter-spacing: -0.03em;"
    >
      Tüfek &amp; Türkan
    </h2>
  </div>
</section>
